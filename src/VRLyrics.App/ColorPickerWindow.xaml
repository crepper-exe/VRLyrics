<Window x:Class="VRLyrics.App.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择颜色与不透明度"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="456"
        Height="510"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource Text1Brush}"
        FontFamily="{StaticResource UiFont}">

    <Border Background="{StaticResource BgBrush}" Padding="24,20,24,22">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 1. Preview & Hex Input -->
            <Grid Grid.Row="0" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="68" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="56"
                        Height="56"
                        CornerRadius="10"
                        BorderBrush="{StaticResource BorderStrongBrush}"
                        BorderThickness="1.5"
                        HorizontalAlignment="Left"
                        Padding="2">
                    <Border.Background>
                        <DrawingBrush TileMode="Tile" Viewport="0,0,8,8" ViewportUnits="Absolute">
                            <DrawingBrush.Drawing>
                                <DrawingGroup>
                                    <GeometryDrawing Brush="#2A2D33" Geometry="M0,0 H2 V2 H0Z" />
                                    <GeometryDrawing Brush="#3A3E45" Geometry="M0,0 H1 V1 H0Z M1,1 H2 V2 H1Z" />
                                </DrawingGroup>
                            </DrawingBrush.Drawing>
                        </DrawingBrush>
                    </Border.Background>
                    <Border x:Name="PreviewColorBorder" CornerRadius="8" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                    <TextBlock x:Name="LblTargetName"
                               Text="颜色设置"
                               FontSize="14.5"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Text1Brush}"
                               Margin="0,0,0,8" />
                    <DockPanel>
                        <TextBlock Text="HEX (#AARRGGBB)"
                                   FontSize="12"
                                   Foreground="{StaticResource Text3Brush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0" />
                        <TextBox x:Name="TxtHex"
                                 Style="{StaticResource DarkTextBoxStyle}"
                                 FontSize="13"
                                 TextChanged="OnHexTextChanged" />
                    </DockPanel>
                </StackPanel>
            </Grid>

            <!-- 2. RGBA Sliders -->
            <Border Grid.Row="1"
                    Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="18,14"
                    Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="92" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="48" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36" />
                        <RowDefinition Height="36" />
                        <RowDefinition Height="36" />
                        <RowDefinition Height="36" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="红色 (R)" Style="{StaticResource FieldLabelText}" />
                    <Slider x:Name="SldR" Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="255" ValueChanged="OnChannelSliderChanged" />
                    <TextBlock x:Name="LblR" Grid.Row="0" Grid.Column="2" Text="255" Style="{StaticResource ValueText}" Foreground="#CFA5A5" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="绿色 (G)" Style="{StaticResource FieldLabelText}" />
                    <Slider x:Name="SldG" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="255" ValueChanged="OnChannelSliderChanged" />
                    <TextBlock x:Name="LblG" Grid.Row="1" Grid.Column="2" Text="255" Style="{StaticResource ValueText}" Foreground="#9EC4AA" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="蓝色 (B)" Style="{StaticResource FieldLabelText}" />
                    <Slider x:Name="SldB" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="255" ValueChanged="OnChannelSliderChanged" />
                    <TextBlock x:Name="LblB" Grid.Row="2" Grid.Column="2" Text="255" Style="{StaticResource ValueText}" Foreground="#A3B9D4" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="不透明度 (A)" Style="{StaticResource FieldLabelText}" />
                    <Slider x:Name="SldA" Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="255" ValueChanged="OnChannelSliderChanged" />
                    <TextBlock x:Name="LblA" Grid.Row="3" Grid.Column="2" Text="255" Style="{StaticResource ValueText}" />
                </Grid>
            </Border>

            <!-- 3. Curated Swatches -->
            <TextBlock Grid.Row="2"
                       Text="常用歌词色卡（点击快速填入）"
                       FontSize="12.5"
                       Foreground="{StaticResource Text3Brush}"
                       Margin="0,0,0,10" />
            <WrapPanel x:Name="SwatchWrapPanel" Grid.Row="3" />

            <!-- 4. Dialog Buttons -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="取消"
                        Style="{StaticResource ActionButtonStyle}"
                        Width="92"
                        Margin="0,0,10,0"
                        IsCancel="True"
                        Click="OnCancelClick" />
                <Button Content="确定应用"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Width="104"
                        IsDefault="True"
                        Click="OnOkClick" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
