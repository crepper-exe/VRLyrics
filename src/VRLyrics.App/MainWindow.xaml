                                    <TextBlock x:Name="LblTransitionMs" Grid.Row="0" Grid.Column="2" Text="220 ms" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#7DD3FC" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="文字抗干扰描边粗细" VerticalAlignment="Center" />
                                    <Slider x:Name="SldStrokeWidth" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="12" SmallChange="0.5" LargeChange="1" ValueChanged="OnEffectsSliderChanged" />
                                    <TextBlock x:Name="LblStrokeWidth" Grid.Row="1" Grid.Column="2" Text="5.5 px" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#7DD3FC" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="文字发光与阴影半径" VerticalAlignment="Center" />
                                    <Slider x:Name="SldShadowBlur" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="20" SmallChange="0.5" LargeChange="2" ValueChanged="OnEffectsSliderChanged" />
                                    <TextBlock x:Name="LblShadowBlur" Grid.Row="2" Grid.Column="2" Text="8.0 px" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#7DD3FC" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="半透明底板圆角半径" VerticalAlignment="Center" />
                                    <Slider x:Name="SldCornerRadius" Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="60" SmallChange="2" LargeChange="8" ValueChanged="OnEffectsSliderChanged" />
                                    <TextBlock x:Name="LblCornerRadius" Grid.Row="3" Grid.Column="2" Text="26 px" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#7DD3FC" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="精细颜色自定义（点击色块打开 Fluent 拾色器，或直接输入 #AARRGGBB）" FontSize="13.5" FontWeight="SemiBold" Foreground="#38BDF8" Margin="0,0,0,10" />
                                <UniformGrid Columns="3">
                                    <StackPanel Orientation="Horizontal" Margin="0,5">
                                        <TextBlock Text="已唱渐变(上)" Width="82" VerticalAlignment="Center" />
                                        <Button x:Name="BtnColorSungTop" Width="30" Height="26" Margin="0,0,6,0" Tag="SungTop" Cursor="Hand" Click="OnColorSwatchClick" />
                                        <TextBox x:Name="TxtColorSungTop" Width="98" Style="{StaticResource DarkTextBoxStyle}" Tag="SungTop" LostFocus="OnColorTextLostFocus" KeyDown="OnColorTextKeyDown" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,5">
                                        <TextBlock Text="已唱渐变(下)" Width="82" VerticalAlignment="Center" />
                                        <Button x:Name="BtnColorSungBottom" Width="30" Height="26" Margin="0,0,6,0" Tag="SungBottom" Cursor="Hand" Click="OnColorSwatchClick" />
                                        <TextBox x:Name="TxtColorSungBottom" Width="98" Style="{StaticResource DarkTextBoxStyle}" Tag="SungBottom" LostFocus="OnColorTextLostFocus" KeyDown="OnColorTextKeyDown" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,5">
                                        <TextBlock Text="已唱外发光" Width="82" VerticalAlignment="Center" />
                                        <Button x:Name="BtnColorSungGlow" Width="30" Height="26" Margin="0,0,6,0" Tag="SungGlow" Cursor="Hand" Click="OnColorSwatchClick" />
                                        <TextBox x:Name="TxtColorSungGlow" Width="98" Style="{StaticResource DarkTextBoxStyle}" Tag="SungGlow" LostFocus="OnColorTextLostFocus" KeyDown="OnColorTextKeyDown" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,5">
                                        <TextBlock Text="未唱渐变(上)" Width="82" VerticalAlignment="Center" />
                                        <Button x:Name="BtnColorUnsungTop" Width="30" Height="26" Margin="0,0,6,0" Tag="UnsungTop" Cursor="Hand" Click="OnColorSwatchClick" />
                                        <TextBox x:Name="TxtColorUnsungTop" Width="98" Style="{StaticResource DarkTextBoxStyle}" Tag="UnsungTop" LostFocus="OnColorTextLostFocus" KeyDown="OnColorTextKeyDown" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,5">
                                        <TextBlock Text="未唱渐变(下)" Width="82" VerticalAlignment="Center" />
                                        <Button x:Name="BtnColorUnsungBottom" Width="30" Height="26" Margin="0,0,6,0" Tag="UnsungBottom" Cursor="Hand" Click="OnColorSwatchClick" />
                                        <TextBox x:Name="TxtColorUnsungBottom" Width="98" Style="{StaticResource DarkTextBoxStyle}" Tag="UnsungBottom" LostFocus="OnColorTextLostFocus" KeyDown="OnColorTextKeyDown" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,5">
                                        <TextBlock Text="翻译文字色" Width="82" VerticalAlignment="Center" />
                                        <Button x:Name="BtnColorTranslation" Width="30" Height="26" Margin="0,0,6,0" Tag="Translation" Cursor="Hand" Click="OnColorSwatchClick" />
                                        <TextBox x:Name="TxtColorTranslation" Width="98" Style="{StaticResource DarkTextBoxStyle}" Tag="Translation" LostFocus="OnColorTextLostFocus" KeyDown="OnColorTextKeyDown" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,5">
                                        <TextBlock Text="上下文行色" Width="82" VerticalAlignment="Center" />
                                        <Button x:Name="BtnColorContext" Width="30" Height="26" Margin="0,0,6,0" Tag="Context" Cursor="Hand" Click="OnColorSwatchClick" />
                                        <TextBox x:Name="TxtColorContext" Width="98" Style="{StaticResource DarkTextBoxStyle}" Tag="Context" LostFocus="OnColorTextLostFocus" KeyDown="OnColorTextKeyDown" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,5">
                                        <TextBlock Text="文字描边色" Width="82" VerticalAlignment="Center" />
                                        <Button x:Name="BtnColorStroke" Width="30" Height="26" Margin="0,0,6,0" Tag="Stroke" Cursor="Hand" Click="OnColorSwatchClick" />
                                        <TextBox x:Name="TxtColorStroke" Width="98" Style="{StaticResource DarkTextBoxStyle}" Tag="Stroke" LostFocus="OnColorTextLostFocus" KeyDown="OnColorTextKeyDown" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,5">
                                        <TextBlock Text="背景底板色" Width="82" VerticalAlignment="Center" />
                                        <Button x:Name="BtnColorBackground" Width="30" Height="26" Margin="0,0,6,0" Tag="Background" Cursor="Hand" Click="OnColorSwatchClick" />
                                        <TextBox x:Name="TxtColorBackground" Width="98" Style="{StaticResource DarkTextBoxStyle}" Tag="Background" LostFocus="OnColorTextLostFocus" KeyDown="OnColorTextKeyDown" />
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ==================== PAGE 4: 时间轴与系统集成 ==================== -->
                    <StackPanel x:Name="PageSystem" Visibility="Collapsed">
                        <StackPanel Margin="2,0,2,10">
                            <TextBlock Text="时间轴与系统集成" FontSize="20" FontWeight="Bold" Foreground="#F8FAFC" />
                            <TextBlock Text="微调全局/单曲时间轴偏移、切换歌词源优先级，以及管理随 SteamVR 自动启动" FontSize="12.5" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,0" />
                        </StackPanel>

                        <!-- Global Offset Card -->
                        <Border Style="{StaticResource SettingsCardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="全局歌词时间偏移调节" FontSize="13.5" FontWeight="SemiBold" Foreground="#38BDF8" />
                                <TextBlock Text="补偿蓝牙耳机或无线串流延迟（正值 = 歌词提前出现；负值 = 歌词延后出现）" FontSize="11.5" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,10" />
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="115" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="全局时间偏移 (ms)" VerticalAlignment="Center" />
                                    <Slider x:Name="SldGlobalOffset" Grid.Column="1" Minimum="-5000" Maximum="5000" SmallChange="50" LargeChange="200" ValueChanged="OnGlobalOffsetSliderChanged" />
                                    <TextBlock x:Name="LblGlobalOffset" Grid.Column="2" Text="+0 ms (0.00s)" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#7DD3FC" />
                                </Grid>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="-500 ms" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0" Tag="-500" Click="OnOffsetStepClick" />
                                    <Button Content="-100 ms" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0" Tag="-100" Click="OnOffsetStepClick" />
                                    <Button Content="重置全局 0 ms" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0" Tag="0" Click="OnOffsetResetClick" />
                                    <Button Content="+100 ms" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0" Tag="100" Click="OnOffsetStepClick" />
                                    <Button Content="+500 ms" Style="{StaticResource ActionButtonStyle}" Tag="500" Click="OnOffsetStepClick" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Per-Track Offset Card -->
                        <Border Style="{StaticResource SettingsCardBorderStyle}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="单曲专属时间偏移（自动按歌曲永久记忆）" FontSize="13.5" FontWeight="SemiBold" Foreground="#38BDF8" VerticalAlignment="Center" />
                                    <TextBlock x:Name="LblTrackOffsetTarget" Text="当前曲目：未在播放" Foreground="{StaticResource MutedTextBrush}" FontSize="11.5" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </DockPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="115" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="当前单曲偏移 (ms)" VerticalAlignment="Center" />
                                    <Slider x:Name="SldTrackOffset" Grid.Column="1" Minimum="-5000" Maximum="5000" SmallChange="50" LargeChange="200" ValueChanged="OnTrackOffsetSliderChanged" />
                                    <TextBlock x:Name="LblTrackOffset" Grid.Column="2" Text="+0 ms (0.00s)" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#7DD3FC" />
                                </Grid>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="-200 ms" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0" Tag="-200" Click="OnTrackOffsetStepClick" />
                                    <Button Content="-50 ms" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0" Tag="-50" Click="OnTrackOffsetStepClick" />
                                    <Button Content="重置单曲 0 ms" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0" Tag="0" Click="OnTrackOffsetResetClick" />
                                    <Button Content="+50 ms" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0" Tag="50" Click="OnTrackOffsetStepClick" />
                                    <Button Content="+200 ms" Style="{StaticResource ActionButtonStyle}" Tag="200" Click="OnTrackOffsetStepClick" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Lyrics Provider Segmented Selector & Local Folders Card -->
                        <Border Style="{StaticResource SettingsCardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="歌词源优先级偏好（与 SteamVR 仪表盘实时联动）" FontSize="13.5" FontWeight="SemiBold" Foreground="#38BDF8" Margin="0,0,0,8" />
                                <Border Background="{StaticResource SubCardBgBrush}"
                                        BorderBrush="#1E293B"
                                        BorderThickness="1"
                                        CornerRadius="9"
                                        Padding="3"
                                        Margin="0,0,0,12">
                                    <UniformGrid Columns="5">
                                        <RadioButton x:Name="RbSourceAuto" Style="{StaticResource SegmentedItemRadioStyle}" Content="⚡ 自动优选" GroupName="LyricsSource" Checked="OnLyricsSourceRadioChecked" />
                                        <RadioButton x:Name="RbSourceNetEase" Style="{StaticResource SegmentedItemRadioStyle}" Content="🎵 网易云(逐字)" GroupName="LyricsSource" Checked="OnLyricsSourceRadioChecked" />
                                        <RadioButton x:Name="RbSourceQqMusic" Style="{StaticResource SegmentedItemRadioStyle}" Content="🎶 QQ音乐(双语)" GroupName="LyricsSource" Checked="OnLyricsSourceRadioChecked" />
                                        <RadioButton x:Name="RbSourceLrclib" Style="{StaticResource SegmentedItemRadioStyle}" Content="🌐 LRCLIB" GroupName="LyricsSource" Checked="OnLyricsSourceRadioChecked" />
                                        <RadioButton x:Name="RbSourceLocal" Style="{StaticResource SegmentedItemRadioStyle}" Content="📁 本地 .lrc" GroupName="LyricsSource" Checked="OnLyricsSourceRadioChecked" />
                                    </UniformGrid>
                                </Border>

                                <TextBlock Text="本地 .lrc 歌词搜索目录" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ListBox x:Name="LstLocalFolders"
                                             Grid.Column="0"
                                             Height="68"
                                             Background="#090E1A"
                                             Foreground="#E2E8F0"
                                             BorderBrush="#334155"
                                             Margin="0,0,10,0" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                        <Button Content="➕ 添加文件夹…" Style="{StaticResource ActionButtonStyle}" Margin="0,0,0,6" Click="OnAddLocalFolderClick" />
                                        <Button Content="➖ 移除选中项" Style="{StaticResource ActionButtonStyle}" Click="OnRemoveLocalFolderClick" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- SteamVR Lifecycle Card -->
                        <Border Style="{StaticResource SettingsCardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="🚀 SteamVR 自动启动与应用清单注册 (vrmanifest)" FontSize="13.5" FontWeight="SemiBold" Foreground="#38BDF8" Margin="0,0,0,10" />
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="随 SteamVR 启动自动运行 VRLyrics（自动最小化到系统托盘）" VerticalAlignment="Center" />
                                    <CheckBox x:Name="ChkAutoStartWithSteamVr" HorizontalAlignment="Right" Checked="OnSteamVrLifecycleCheckChanged" Unchecked="OnSteamVrLifecycleCheckChanged" />
                                </DockPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <TextBlock Text="当 SteamVR 退出时自动关闭 VRLyrics" VerticalAlignment="Center" />
                                    <CheckBox x:Name="ChkExitWithSteamVr" HorizontalAlignment="Right" Checked="OnSteamVrLifecycleCheckChanged" Unchecked="OnSteamVrLifecycleCheckChanged" />
                                </DockPanel>
                                <TextBlock x:Name="TxtManifestStatus" Foreground="{StaticResource MutedTextBrush}" FontSize="11.5" Margin="0,0,0,10" TextWrapping="Wrap" />
                                <WrapPanel>
                                    <Button Content="📝 立即注册/刷新 vrmanifest" Style="{StaticResource ActionButtonStyle}" Margin="0,0,10,0" Click="OnRegisterManifestClick" />
                                    <Button Content="🗑️ 从 SteamVR 移除注册" Style="{StaticResource ActionButtonStyle}" Click="OnUnregisterManifestClick" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Storage & Reset Card -->
                        <Border Style="{StaticResource SettingsCardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="配置存储与维护" FontSize="13.5" FontWeight="SemiBold" Foreground="#38BDF8" Margin="0,0,0,4" />
                                <TextBlock x:Name="TxtSettingsFilePath" Foreground="{StaticResource MutedTextBrush}" FontSize="11.5" Margin="0,0,0,10" />
                                <WrapPanel>
                                    <Button Content="📂 打开配置与缓存目录" Style="{StaticResource ActionButtonStyle}" Margin="0,0,10,0" Click="OnOpenConfigFolderClick" />
                                    <Button Content="🔄 忽略缓存重新拉取当前歌词" Style="{StaticResource ActionButtonStyle}" Margin="0,0,10,0" Click="OnReloadLyricsClick" />
                                    <Button Content="⚠️ 恢复全部默认设置" Style="{StaticResource DangerButtonStyle}" Click="OnResetAllSettingsClick" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
