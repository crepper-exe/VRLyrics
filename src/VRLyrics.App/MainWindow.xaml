<Window x:Class="VRLyrics.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VRLyrics · SteamVR Lyrics Control"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="1200"
        Height="940"
        MinWidth="980"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource Text1Brush}"
        FontFamily="{StaticResource UiFont}">

    <!-- ==================== ROOT LAYOUT ==================== -->
    <Grid Background="{StaticResource BgBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="264" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ==================== LEFT SIDEBAR ==================== -->
        <Border Grid.Column="0"
                Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0"
                Padding="20,24,20,22">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 1. Brand Header -->
                <StackPanel Grid.Row="0" Margin="4,0,4,22">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/Assets/logo.png"
                               Height="32"
                               Margin="0,0,12,0"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="VRLyrics"
                                       FontSize="19"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource Text1Brush}" />
                            <TextBlock Text="SteamVR Lyrics Studio"
                                       FontSize="11.5"
                                       Foreground="{StaticResource Text3Brush}"
                                       Margin="0,1,0,0" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- 2. Live VR & Player Status Card -->
                <Border Grid.Row="1"
                        Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14,13"
                        Margin="0,0,0,22">
                    <StackPanel>
                        <Border x:Name="VrStatusBadge"
                                Background="#25221C"
                                BorderBrush="#574D3C"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,6"
                                Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path x:Name="VrStatusIcon"
                                      Width="15"
                                      Height="15"
                                      Stretch="Uniform"
                                      VerticalAlignment="Center"
                                      Margin="0,0,8,0"
                                      Fill="#D2C5AC"
                                      Data="M496 256c0 137-111.2 248-248.4 248-113.8 0-209.6-76.3-239-180.4l95.2 39.3c6.4 32.1 34.9 56.4 68.9 56.4 39.2 0 71.9-32.4 70.2-73.5l84.5-60.2c52.1 1.3 95.8-40.9 95.8-93.5 0-51.6-42-93.5-93.7-93.5s-93.7 42-93.7 93.5v1.2L176.6 279c-15.5-.9-30.7 3.4-43.5 12.1L0 236.1C10.2 108.4 117.1 8 247.6 8 384.8 8 496 119 496 256zM155.7 384.3l-30.5-12.6a52.79 52.79 0 0 0 27.2 25.8c26.9 11.2 57.8-1.6 69-28.4 5.4-13 5.5-27.3.1-40.3-5.4-13-15.5-23.2-28.5-28.6-12.9-5.4-26.7-5.2-38.9-.6l31.5 13c19.8 8.2 29.2 30.9 20.9 50.7-8.3 19.9-31 29.2-50.8 21zm173.8-129.9c-34.4 0-62.4-28-62.4-62.3s28-62.3 62.4-62.3 62.4 28 62.4 62.3-27.9 62.3-62.4 62.3zm.1-15.6c25.9 0 46.9-21 46.9-46.8 0-25.9-21-46.8-46.9-46.8s-46.9 21-46.9 46.8c.1 25.8 21.1 46.8 46.9 46.8z" />
                                <TextBlock x:Name="VrStatusText"
                                           Text="未连接 SteamVR"
                                           FontSize="12"
                                           FontWeight="Medium"
                                           Foreground="#D2C5AC"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="PlayerStatusText"
                                   Text="播放器：未检测"
                                   FontSize="12"
                                   Foreground="{StaticResource Text2Brush}"
                                   Margin="2,0,0,5"
                                   TextTrimming="CharacterEllipsis" />

                        <TextBlock x:Name="TrackAndLyricsStatusText"
                                   Text="正在等待播放曲目…"
                                   FontSize="11.5"
                                   Foreground="{StaticResource Text3Brush}"
                                   Margin="2,0,0,0"
                                   LineHeight="17"
                                   TextWrapping="Wrap" />

                        <Border Style="{StaticResource RowDivider}" Margin="0,11,0,10" />

                        <!-- Media Transport Controls (Previous / Play-Pause / Next) -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="46" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="46" />
                            </Grid.ColumnDefinitions>

                            <Button x:Name="BtnMediaPrev"
                                    Grid.Column="0"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Padding="0,7"
                                    ToolTip="上一首"
                                    Click="OnMediaPrevClick">
                                <Path Width="13"
                                      Height="13"
                                      Stretch="Uniform"
                                      Fill="{StaticResource Text1Brush}"
                                      Data="M6 6h2v12H6zm3.5 6l8.5 6V6z" />
                            </Button>

                            <Button x:Name="BtnMediaPlayPause"
                                    Grid.Column="2"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Padding="8,7"
                                    ToolTip="播放 / 暂停"
                                    Click="OnMediaPlayPauseClick">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path x:Name="IconMediaPlayPause"
                                          Width="12"
                                          Height="12"
                                          Stretch="Uniform"
                                          VerticalAlignment="Center"
                                          Margin="0,0,6,0"
                                          Fill="{StaticResource Text1Brush}"
                                          Data="M8 5v14l11-7z" />
                                    <TextBlock x:Name="TxtMediaPlayPause"
                                               Text="播放"
                                               FontSize="12.5"
                                               FontWeight="Medium"
                                               Foreground="{StaticResource Text1Brush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="BtnMediaNext"
                                    Grid.Column="4"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Padding="0,7"
                                    ToolTip="下一首"
                                    Click="OnMediaNextClick">
                                <Path Width="13"
                                      Height="13"
                                      Stretch="Uniform"
                                      Fill="{StaticResource Text1Brush}"
                                      Data="M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z" />
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 3. Navigation Menu Items -->
                <StackPanel Grid.Row="2">
                    <TextBlock Text="NAVIGATION"
                               FontSize="11"
                               FontWeight="Medium"
                               Foreground="{StaticResource Text3Brush}"
                               Margin="10,0,0,8" />
                    <RadioButton x:Name="NavPlacement"
                                 Style="{StaticResource NavItemRadioStyle}"
                                 GroupName="MainNav"
                                 Tag="&#xE809;"
                                 Content="显示与空间锚定"
                                 IsChecked="True"
                                 Checked="OnNavPageRadioChecked" />
                    <RadioButton x:Name="NavTypography"
                                 Style="{StaticResource NavItemRadioStyle}"
                                 GroupName="MainNav"
                                 Tag="&#xE8D2;"
                                 Content="字体与排版布局"
                                 Checked="OnNavPageRadioChecked" />
                    <RadioButton x:Name="NavColors"
                                 Style="{StaticResource NavItemRadioStyle}"
                                 GroupName="MainNav"
                                 Tag="&#xE790;"
                                 Content="色彩主题与动效"
                                 Checked="OnNavPageRadioChecked" />
                    <RadioButton x:Name="NavSystem"
                                 Style="{StaticResource NavItemRadioStyle}"
                                 GroupName="MainNav"
                                 Tag="&#xE916;"
                                 Content="时间轴与系统集成"
                                 Checked="OnNavPageRadioChecked" />
                </StackPanel>

                <!-- 4. Sidebar Footer Quick Toggles & Window Actions -->
                <Border Grid.Row="3"
                        Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="16,14">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock Text="显示 VR 歌词"
                                       FontSize="13"
                                       FontWeight="Medium"
                                       Foreground="{StaticResource Text1Brush}"
                                       VerticalAlignment="Center" />
                            <CheckBox x:Name="ChkOverlayEnabled"
                                      HorizontalAlignment="Right"
                                      Checked="OnOverlayEnabledChanged"
                                      Unchecked="OnOverlayEnabledChanged" />
                        </DockPanel>

                        <DockPanel Margin="0,0,0,14">
                            <TextBlock Text="样式演示动画"
                                       FontSize="13"
                                       Foreground="{StaticResource Text2Brush}"
                                       VerticalAlignment="Center"
                                       ToolTip="开启后在预览区和 VR 中循环播放逐字卡拉OK演示歌词" />
                            <CheckBox x:Name="ChkDemoLoop"
                                      HorizontalAlignment="Right"
                                      Checked="OnDemoLoopChanged"
                                      Unchecked="OnDemoLoopChanged" />
                        </DockPanel>

                        <Button Content="重新获取当前歌词"
                                Style="{StaticResource ActionButtonStyle}"
                                Margin="0,0,0,8"
                                Click="OnReloadLyricsClick" />

                        <UniformGrid Columns="2">
                            <Button Content="最小化托盘"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Margin="0,0,5,0"
                                    Padding="8,7"
                                    Click="OnMinimizeToTrayClick" />
                            <Button Content="彻底退出"
                                    Style="{StaticResource DangerButtonStyle}"
                                    Margin="5,0,0,0"
                                    Padding="8,7"
                                    Click="OnExitAppClick" />
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ==================== RIGHT MAIN CONTENT AREA ==================== -->
        <Grid Grid.Column="1" Margin="32,24,28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 1. Pinned Live 1:1 VR Overlay Preview Card (Collapsible) -->
            <Border Grid.Row="0"
                    Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20,14"
                    Margin="0,0,0,14">
                <StackPanel>
                    <DockPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="实时画面预览"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource Text1Brush}"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="PreviewMetaText"
                                       Text="1600 × 420 · 60 FPS · 与 VR 头显 1:1 同步"
                                       FontSize="12"
                                       Foreground="{StaticResource Text3Brush}"
                                       VerticalAlignment="Center"
                                       Margin="14,0,0,0" />
                        </StackPanel>

                        <Button x:Name="BtnTogglePreviewCollapse"
                                Content="收起预览 ▲"
                                Style="{StaticResource GhostButtonStyle}"
                                HorizontalAlignment="Right"
                                Click="OnTogglePreviewCollapseClick" />
                    </DockPanel>

                    <Border x:Name="PreviewCanvasContainer"
                            Height="136"
                            Margin="0,12,0,0"
                            CornerRadius="9"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            ClipToBounds="True">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#161920" Offset="0" />
                                <GradientStop Color="#101216" Offset="0.55" />
                                <GradientStop Color="#171B22" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Image x:Name="PreviewImage"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- 2. Scrollable Settings Pages with Top & Bottom Gradient Boundary Masks -->
            <Border Grid.Row="1" Background="Transparent" ClipToBounds="True">
                <Border.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00000000" Offset="0.00" />
                        <GradientStop Color="#80000000" Offset="0.016" />
                        <GradientStop Color="#FF000000" Offset="0.035" />
                        <GradientStop Color="#FF000000" Offset="0.88" />
                        <GradientStop Color="#80000000" Offset="0.94" />
                        <GradientStop Color="#1A000000" Offset="0.98" />
                        <GradientStop Color="#00000000" Offset="1.00" />
                    </LinearGradientBrush>
                </Border.OpacityMask>

                <Grid>
                    <ScrollViewer x:Name="MainPageScrollViewer"
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="0,18,10,36">
                        <Grid>
                    <!-- ==================== PAGE 1: 显示与空间锚定 ==================== -->
                    <StackPanel x:Name="PagePlacement" Visibility="Visible">
                        <DockPanel Margin="2,0,2,20">
                            <StackPanel>
                                <TextBlock Text="显示与空间锚定" Style="{StaticResource PageTitleText}" />
                                <TextBlock Text="选择歌词在 VR 空间中的挂载方式，并调节物理尺寸、环绕曲面与三维姿态" Style="{StaticResource PageDescText}" />
                            </StackPanel>
                            <Button Content="恢复当前位置默认参数"
                                    Style="{StaticResource ActionButtonStyle}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Click="OnResetPlacementClick" />
                        </DockPanel>

                        <!-- Mode Segmented Selector + Physical Dimensions Combined cleanly -->
                        <Border Style="{StaticResource SettingsCardBorderStyle}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,12">
                                    <TextBlock Text="空间挂载模式" Style="{StaticResource CardTitleText}" />
                                    <TextBlock Text="切换不同模式将自动加载各自独立保存的坐标参数"
                                               FontSize="12"
                                               Foreground="{StaticResource Text3Brush}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center" />
                                </DockPanel>

                                <Border Style="{StaticResource SegmentedTrackStyle}">
                                    <UniformGrid Columns="4">
                                        <RadioButton x:Name="RbModeHead" Style="{StaticResource SegmentedItemRadioStyle}" GroupName="AttachMode" Content="头部跟随" Checked="OnAttachmentModeRadioChecked" />
                                        <RadioButton x:Name="RbModeWorld" Style="{StaticResource SegmentedItemRadioStyle}" GroupName="AttachMode" Content="空间固定 (手柄拖拽)" Checked="OnAttachmentModeRadioChecked" />
                                        <RadioButton x:Name="RbModeLeftHand" Style="{StaticResource SegmentedItemRadioStyle}" GroupName="AttachMode" Content="左手腕跟随" Checked="OnAttachmentModeRadioChecked" />
                                        <RadioButton x:Name="RbModeRightHand" Style="{StaticResource SegmentedItemRadioStyle}" GroupName="AttachMode" Content="右手腕跟随" Checked="OnAttachmentModeRadioChecked" />
                                    </UniformGrid>
                                </Border>

                                <Border Style="{StaticResource RowDivider}" Margin="0,18,0,14" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="86" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="42" />
                                        <RowDefinition Height="42" />
                                        <RowDefinition Height="42" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="画面物理宽度 (Width)" Style="{StaticResource FieldLabelText}" />
                                    <Slider x:Name="SldWidthMeters" Grid.Row="0" Grid.Column="1" Minimum="0.25" Maximum="2.40" SmallChange="0.05" LargeChange="0.2" ValueChanged="OnPlacementSliderChanged" />
                                    <TextBlock x:Name="LblWidthMeters" Grid.Row="0" Grid.Column="2" Text="1.00 m" Style="{StaticResource ValueText}" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="整体不透明度 (Opacity)" Style="{StaticResource FieldLabelText}" />
                                    <Slider x:Name="SldOpacity" Grid.Row="1" Grid.Column="1" Minimum="0.15" Maximum="1.00" SmallChange="0.05" LargeChange="0.1" ValueChanged="OnPlacementSliderChanged" />
                                    <TextBlock x:Name="LblOpacity" Grid.Row="1" Grid.Column="2" Text="96%" Style="{StaticResource ValueText}" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="曲面环绕弧度 (Curvature)" Style="{StaticResource FieldLabelText}" />
                                    <Slider x:Name="SldCurvature" Grid.Row="2" Grid.Column="1" Minimum="0.00" Maximum="0.40" SmallChange="0.02" LargeChange="0.05" ValueChanged="OnPlacementSliderChanged" />
                                    <TextBlock x:Name="LblCurvature" Grid.Row="2" Grid.Column="2" Text="8%" Style="{StaticResource ValueText}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Mode Panel A: HeadLocked (2-Column Spacious Layout) -->
                        <Border x:Name="PanelHeadMode" Style="{StaticResource SettingsCardBorderStyle}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,16">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="头部跟随偏移与倾角" Style="{StaticResource CardTitleText}" />
                                        <TextBlock Text="相对于头显视野中心的空间偏移量与旋转倾角" Style="{StaticResource CardDescText}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Content="视野正下方" Style="{StaticResource ActionButtonStyle}" Padding="12,6" Margin="0,0,8,0" Tag="BottomCenter" Click="OnHeadPresetClick" />
                                        <Button Content="视野正上方" Style="{StaticResource ActionButtonStyle}" Padding="12,6" Margin="0,0,8,0" Tag="Top" Click="OnHeadPresetClick" />
                                        <Button Content="左下角" Style="{StaticResource ActionButtonStyle}" Padding="12,6" Margin="0,0,8,0" Tag="BottomLeft" Click="OnHeadPresetClick" />
                                        <Button Content="右下角" Style="{StaticResource ActionButtonStyle}" Padding="12,6" Tag="BottomRight" Click="OnHeadPresetClick" />
                                    </StackPanel>
                                </DockPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Left Column: X / Y / Z Offsets -->
                                    <Grid Grid.Column="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="74" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="42" />
                                            <RowDefinition Height="42" />
                                            <RowDefinition Height="42" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="水平偏移 X" Style="{StaticResource FieldLabelText}" />
                                        <Slider x:Name="SldHeadX" Grid.Row="0" Grid.Column="1" Minimum="-0.80" Maximum="0.80" SmallChange="0.02" LargeChange="0.1" ValueChanged="OnPlacementSliderChanged" />
                                        <TextBlock x:Name="LblHeadX" Grid.Row="0" Grid.Column="2" Text="+0.00 m" Style="{StaticResource ValueText}" />

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="垂直偏移 Y" Style="{StaticResource FieldLabelText}" />
                                        <Slider x:Name="SldHeadY" Grid.Row="1" Grid.Column="1" Minimum="-0.75" Maximum="0.75" SmallChange="0.02" LargeChange="0.1" ValueChanged="OnPlacementSliderChanged" />
                                        <TextBlock x:Name="LblHeadY" Grid.Row="1" Grid.Column="2" Text="-0.24 m" Style="{StaticResource ValueText}" />

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="前后距离 Z" Style="{StaticResource FieldLabelText}" />
                                        <Slider x:Name="SldHeadZ" Grid.Row="2" Grid.Column="1" Minimum="-2.80" Maximum="-0.45" SmallChange="0.05" LargeChange="0.2" ValueChanged="OnPlacementSliderChanged" />
                                        <TextBlock x:Name="LblHeadZ" Grid.Row="2" Grid.Column="2" Text="-1.15 m" Style="{StaticResource ValueText}" />
                                    </Grid>

                                    <!-- Right Column: Pitch / Yaw Angles -->
                                    <Grid Grid.Column="2" VerticalAlignment="Top">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="74" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="42" />
                                            <RowDefinition Height="42" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="俯仰倾角 Pitch" Style="{StaticResource FieldLabelText}" />
                                        <Slider x:Name="SldHeadPitch" Grid.Row="0" Grid.Column="1" Minimum="-45" Maximum="45" SmallChange="1" LargeChange="5" ValueChanged="OnPlacementSliderChanged" />
                                        <TextBlock x:Name="LblHeadPitch" Grid.Row="0" Grid.Column="2" Text="+12.0°" Style="{StaticResource ValueText}" />

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="水平偏航 Yaw" Style="{StaticResource FieldLabelText}" />
                                        <Slider x:Name="SldHeadYaw" Grid.Row="1" Grid.Column="1" Minimum="-45" Maximum="45" SmallChange="1" LargeChange="5" ValueChanged="OnPlacementSliderChanged" />
                                        <TextBlock x:Name="LblHeadYaw" Grid.Row="1" Grid.Column="2" Text="0.0°" Style="{StaticResource ValueText}" />
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Mode Panel B: WorldLocked (2-Column Spacious Layout) -->
                        <Border x:Name="PanelWorldMode" Style="{StaticResource SettingsCardBorderStyle}" Visibility="Collapsed">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,16">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="空间固定坐标与 VR 手柄交互" Style="{StaticResource CardTitleText}" />
                                        <TextBlock Text="在 VR 中用手柄指向歌词并按住 Grip (侧键) 或 Trigger (扳机) 即可自由拖动位置，推摇杆调节远近" Style="{StaticResource CardDescText}" />
                                    </StackPanel>
                                    <Button Content="移至当前头显视野正前方"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Click="OnRecenterWorldToHmdClick" />
                                </DockPanel>

                                <WrapPanel Margin="0,0,0,16">
                                    <CheckBox x:Name="ChkWorldControllerGrab"
                                              Content="允许使用 VR 手柄抓取拖动歌词"
                                              Margin="0,0,36,4"
                                              Checked="OnWorldGrabCheckChanged"
                                              Unchecked="OnWorldGrabCheckChanged" />
                                    <CheckBox x:Name="ChkWorldAutoFaceHmd"
                                              Content="拖动时自动使歌词正面朝向头显"
                                              Margin="0,0,0,4"
                                              Checked="OnWorldGrabCheckChanged"
                                              Unchecked="OnWorldGrabCheckChanged" />
                                </WrapPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Column="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="74" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="42" />
                                            <RowDefinition Height="42" />
                                            <RowDefinition Height="42" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="世界坐标 X (左右)" Style="{StaticResource FieldLabelText}" />
                                        <Slider x:Name="SldWorldX" Grid.Row="0" Grid.Column="1" Minimum="-3.00" Maximum="3.00" SmallChange="0.05" LargeChange="0.2" ValueChanged="OnPlacementSliderChanged" />
                                        <TextBlock x:Name="LblWorldX" Grid.Row="0" Grid.Column="2" Text="+0.00 m" Style="{StaticResource ValueText}" />

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="世界坐标 Y (高度)" Style="{StaticResource FieldLabelText}" />
                                        <Slider x:Name="SldWorldY" Grid.Row="1" Grid.Column="1" Minimum="0.20" Maximum="2.80" SmallChange="0.05" LargeChange="0.2" ValueChanged="OnPlacementSliderChanged" />
                                        <TextBlock x:Name="LblWorldY" Grid.Row="1" Grid.Column="2" Text="1.30 m" Style="{StaticResource ValueText}" />

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="世界坐标 Z (前后)" Style="{StaticResource FieldLabelText}" />
                                        <Slider x:Name="SldWorldZ" Grid.Row="2" Grid.Column="1" Minimum="-3.50" Maximum="3.50" SmallChange="0.05" LargeChange="0.2" ValueChanged="OnPlacementSliderChanged" />
                                        <TextBlock x:Name="LblWorldZ" Grid.Row="2" Grid.Column="2" Text="-1.40 m" Style="{StaticResource ValueText}" />
                                    </Grid>

                                    <Grid Grid.Column="2" VerticalAlignment="Top">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="74" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="42" />
                                            <RowDefinition Height="42" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="水平朝向 Yaw" Style="{StaticResource FieldLabelText}" />
                                        <Slider x:Name="SldWorldYaw" Grid.Row="0" Grid.Column="1" Minimum="-180" Maximum="180" SmallChange="2" LargeChange="15" ValueChanged="OnPlacementSliderChanged" />
                                        <TextBlock x:Name="LblWorldYaw" Grid.Row="0" Grid.Column="2" Text="0.0°" Style="{StaticResource ValueText}" />

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="俯仰倾角 Pitch" Style="{StaticResource FieldLabelText}" />
                                        <Slider x:Name="SldWorldPitch" Grid.Row="1" Grid.Column="1" Minimum="-60" Maximum="60" SmallChange="1" LargeChange="10" ValueChanged="OnPlacementSliderChanged" />
                                        <TextBlock x:Name="LblWorldPitch" Grid.Row="1" Grid.Column="2" Text="0.0°" Style="{StaticResource ValueText}" />
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Mode Panel C: LeftHand / RightHand (2-Column Spacious Layout) -->
                        <Border x:Name="PanelHandMode" Style="{StaticResource SettingsCardBorderStyle}" Visibility="Collapsed">
