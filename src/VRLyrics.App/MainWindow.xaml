<Window x:Class="VRLyrics.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VRLyrics - SteamVR 实时歌词设置"
        Width="1040"
        Height="820"
        MinWidth="880"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="#0B0F19"
        Foreground="#F1F5F9"
        FontFamily="Microsoft YaHei UI">

    <Window.Resources>
        <SolidColorBrush x:Key="CardBgBrush" Color="#131B2E" />
        <SolidColorBrush x:Key="CardBorderBrush" Color="#24324D" />
        <SolidColorBrush x:Key="AccentBrush" Color="#00D2FF" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F1F5F9" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#94A3B8" />
        <SolidColorBrush x:Key="InputBgBrush" Color="#0D1322" />

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="Foreground" Value="#F1F5F9" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#283750" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#00D2FF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#172133" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#0284C7" />
            <Setter Property="BorderBrush" Value="#38BDF8" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#3B1824" />
            <Setter Property="BorderBrush" Value="#7F1D3A" />
            <Setter Property="Foreground" Value="#FDA4AF" />
        </Style>

        <Style x:Key="DarkTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#0D1322" />
            <Setter Property="Foreground" Value="#F1F5F9" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="CaretBrush" Value="#00D2FF" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E2E8F0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#F1F5F9" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style TargetType="Slider">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="18,9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="#101726"
                                BorderBrush="#24324D"
                                BorderThickness="1,1,1,0"
                                CornerRadius="8,8,0,0"
                                Margin="0,0,6,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#131B2E" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#00D2FF" />
                                <Setter Property="Foreground" Value="#38BDF8" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#F8FAFC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18,14,18,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ==================== 1. TOP STATUS & ACTION BAR ==================== -->
        <Border Grid.Row="0"
                Background="{StaticResource CardBgBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="16,12"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Vertical">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="VRLyrics" FontSize="20" FontWeight="Bold" Foreground="#38BDF8" />
                        <TextBlock Text="SteamVR 实时歌词叠加层" FontSize="13" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Bottom" Margin="10,0,14,2" />

                        <Border x:Name="VrStatusBadge" Background="#162936" BorderBrush="#0284C7" BorderThickness="1" CornerRadius="12" Padding="10,3" Margin="0,0,8,0">
                            <TextBlock x:Name="VrStatusText" Text="等待 SteamVR…" FontSize="12" Foreground="#7DD3FC" />
                        </Border>

                        <Border Background="#182236" BorderBrush="#334155" BorderThickness="1" CornerRadius="12" Padding="10,3">
                            <TextBlock x:Name="PlayerStatusText" Text="播放器：未检测" FontSize="12" Foreground="#CBD5E1" />
                        </Border>
                    </StackPanel>

                    <TextBlock x:Name="TrackAndLyricsStatusText"
                               Text="正在等待播放曲目…"
                               FontSize="12.5"
                               Foreground="#94A3B8"
                               Margin="0,6,0,0"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="ChkOverlayEnabled"
                              Content="显示 VR 歌词"
                              FontWeight="SemiBold"
                              Margin="0,0,14,0"
                              Checked="OnOverlayEnabledChanged"
                              Unchecked="OnOverlayEnabledChanged" />

                    <CheckBox x:Name="ChkDemoLoop"
                              Content="🎬 样式演示动画"
                              ToolTip="开启后在预览区和VR中循环播放逐字卡拉OK演示歌词，方便暂停或无音乐时调色"
                              Margin="0,0,14,0"
                              Checked="OnDemoLoopChanged"
                              Unchecked="OnDemoLoopChanged" />

                    <Button Content="🔄 重新获取歌词"
                            Style="{StaticResource ActionButtonStyle}"
                            Margin="0,0,8,0"
                            Click="OnReloadLyricsClick" />

                    <Button Content="最小化到托盘"
                            Style="{StaticResource ActionButtonStyle}"
                            Margin="0,0,8,0"
                            Click="OnMinimizeToTrayClick" />

                    <Button Content="彻底退出"
                            Style="{StaticResource DangerButtonStyle}"
                            Click="OnExitAppClick" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== 2. LIVE OVERLAY RENDER PREVIEW ==================== -->
        <Border Grid.Row="1"
                Background="#070A12"
                BorderBrush="#24324D"
                BorderThickness="1"
                CornerRadius="10"
                Padding="12,10"
                Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="175" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="2,0,2,6">
                    <TextBlock Text="实时叠加层渲染预览（与 VR 头显内 1:1 同步）"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#7DD3FC" />
                    <TextBlock x:Name="PreviewMetaText"
                               Text="1600×420 · 60 FPS · 配置变更即时生效"
                               FontSize="11.5"
                               Foreground="#64748B"
                               HorizontalAlignment="Right" />
                </DockPanel>

                <Border Grid.Row="1"
                        CornerRadius="8"
                        BorderBrush="#1E293B"
                        BorderThickness="1"
                        ClipToBounds="True">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#121B2E" Offset="0" />
                            <GradientStop Color="#090D18" Offset="0.55" />
                            <GradientStop Color="#152238" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Image x:Name="PreviewImage"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>
            </Grid>
        </Border>

        <!-- ==================== 3. SETTINGS TABS ==================== -->
        <TabControl Grid.Row="2"
                    Background="{StaticResource CardBgBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1"
                    Padding="14">

            <!-- TAB 1: 显示与位置 -->
            <TabItem Header="📍 显示与位置">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,4,10,4">
                    <StackPanel>
                        <DockPanel Margin="0,2,0,8">
                            <TextBlock Text="挂载位置模式" FontSize="14" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center" />
                            <Button Content="恢复当前模式默认位置"
                                    Style="{StaticResource ActionButtonStyle}"
                                    HorizontalAlignment="Right"
                                    Padding="10,4"
                                    Click="OnResetPlacementClick" />
                        </DockPanel>

                        <UniformGrid Columns="4" Margin="0,0,0,14">
                            <RadioButton x:Name="RbModeHead" GroupName="AttachMode" Content="👀 头部跟随 (视野下方)" Foreground="#F1F5F9" FontSize="13" Margin="0,4" Checked="OnAttachmentModeRadioChecked" />
                            <RadioButton x:Name="RbModeWorld" GroupName="AttachMode" Content="🌍 空间固定 (可手柄拖拽)" Foreground="#F1F5F9" FontSize="13" Margin="0,4" Checked="OnAttachmentModeRadioChecked" />
                            <RadioButton x:Name="RbModeLeftHand" GroupName="AttachMode" Content="⌚ 左手腕跟随" Foreground="#F1F5F9" FontSize="13" Margin="0,4" Checked="OnAttachmentModeRadioChecked" />
                            <RadioButton x:Name="RbModeRightHand" GroupName="AttachMode" Content="⌚ 右手腕跟随" Foreground="#F1F5F9" FontSize="13" Margin="0,4" Checked="OnAttachmentModeRadioChecked" />
                        </UniformGrid>

                        <TextBlock Text="基础尺寸、曲面与透明度" FontSize="14" FontWeight="Bold" Foreground="#38BDF8" Margin="0,2,0,8" />
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="175" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="32" />
                                <RowDefinition Height="32" />
                                <RowDefinition Height="32" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="叠加层物理宽度 (米)" VerticalAlignment="Center" />
                            <Slider x:Name="SldWidthMeters" Grid.Row="0" Grid.Column="1" Minimum="0.25" Maximum="2.40" SmallChange="0.05" LargeChange="0.1" ValueChanged="OnPlacementSliderChanged" />
                            <TextBlock x:Name="LblWidthMeters" Grid.Row="0" Grid.Column="2" Text="0.95 m" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#7DD3FC" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="叠加层整体不透明度" VerticalAlignment="Center" />
                            <Slider x:Name="SldOpacity" Grid.Row="1" Grid.Column="1" Minimum="0.15" Maximum="1.00" SmallChange="0.02" LargeChange="0.1" ValueChanged="OnPlacementSliderChanged" />
                            <TextBlock x:Name="LblOpacity" Grid.Row="1" Grid.Column="2" Text="96%" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#7DD3FC" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="面板环绕曲面弧度" VerticalAlignment="Center" />
                            <Slider x:Name="SldCurvature" Grid.Row="2" Grid.Column="1" Minimum="0.00" Maximum="0.35" SmallChange="0.01" LargeChange="0.05" ValueChanged="OnPlacementSliderChanged" />
                            <TextBlock x:Name="LblCurvature" Grid.Row="2" Grid.Column="2" Text="8%" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#7DD3FC" />
                        </Grid>

                        <!-- (A) 头部跟随专属参数面板 -->
                        <Border x:Name="PanelHeadMode"
                                Background="#0E1525"
                                BorderBrush="#24324D"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14,12">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <TextBlock Text="👀 头部跟随 (Head-Locked) 视野位置微调" FontSize="13.5" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="正下方 (默认)" Tag="Bottom" Style="{StaticResource ActionButtonStyle}" Padding="10,3" Margin="0,0,6,0" Click="OnHeadPresetClick" />
                                        <Button Content="正上方" Tag="Top" Style="{StaticResource ActionButtonStyle}" Padding="10,3" Margin="0,0,6,0" Click="OnHeadPresetClick" />
                                        <Button Content="左下方" Tag="BottomLeft" Style="{StaticResource ActionButtonStyle}" Padding="10,3" Margin="0,0,6,0" Click="OnHeadPresetClick" />
                                        <Button Content="右下方" Tag="BottomRight" Style="{StaticResource ActionButtonStyle}" Padding="10,3" Click="OnHeadPresetClick" />
                                    </StackPanel>
                                </DockPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="175" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="30" />
                                        <RowDefinition Height="30" />
                                        <RowDefinition Height="30" />
                                        <RowDefinition Height="30" />
                                        <RowDefinition Height="30" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="水平左右偏移 (X)" VerticalAlignment="Center" />
                                    <Slider x:Name="SldHeadX" Grid.Row="0" Grid.Column="1" Minimum="-0.80" Maximum="0.80" ValueChanged="OnPlacementSliderChanged" />
                                    <TextBlock x:Name="LblHeadX" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#CBD5E1" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="垂直上下偏移 (Y)" VerticalAlignment="Center" />
                                    <Slider x:Name="SldHeadY" Grid.Row="1" Grid.Column="1" Minimum="-0.80" Maximum="0.80" ValueChanged="OnPlacementSliderChanged" />
                                    <TextBlock x:Name="LblHeadY" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#CBD5E1" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="视野前后距离 (Z)" VerticalAlignment="Center" />
                                    <Slider x:Name="SldHeadZ" Grid.Row="2" Grid.Column="1" Minimum="-2.50" Maximum="-0.45" ValueChanged="OnPlacementSliderChanged" />
                                    <TextBlock x:Name="LblHeadZ" Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#CBD5E1" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="俯仰倾角 (Pitch °)" VerticalAlignment="Center" />
                                    <Slider x:Name="SldHeadPitch" Grid.Row="3" Grid.Column="1" Minimum="-45" Maximum="45" ValueChanged="OnPlacementSliderChanged" />
                                    <TextBlock x:Name="LblHeadPitch" Grid.Row="3" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#CBD5E1" />

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="水平偏航角 (Yaw °)" VerticalAlignment="Center" />
                                    <Slider x:Name="SldHeadYaw" Grid.Row="4" Grid.Column="1" Minimum="-45" Maximum="45" ValueChanged="OnPlacementSliderChanged" />
                                    <TextBlock x:Name="LblHeadYaw" Grid.Row="4" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#CBD5E1" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- (B) 空间固定与手柄拖拽专属参数面板 -->
                        <Border x:Name="PanelWorldMode"
                                Background="#0E1525"
                                BorderBrush="#24324D"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14,12"
                                Visibility="Collapsed">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="🌍 空间固定 (World-Locked) 坐标与 VR 手柄抓取" FontSize="13.5" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center" />
                                    <Button Content="📍 将空间歌词移至当前头显视野正前方"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            HorizontalAlignment="Right"
                                            Padding="12,4"
                                            Click="OnRecenterWorldToHmdClick" />
                                </DockPanel>

                                <WrapPanel Margin="0,0,0,8">
                                    <CheckBox x:Name="ChkWorldControllerGrab"
                                              Content="✋ 允许在 VR 中用手柄抓取拖动歌词面板"
                                              Margin="0,0,22,0"
                                              Checked="OnWorldGrabCheckChanged"
                                              Unchecked="OnWorldGrabCheckChanged" />
                                    <CheckBox x:Name="ChkWorldAutoFaceHmd"
                                              Content="🎯 拖动释放时自动朝向头显视线（保持水平）"
                                              Checked="OnWorldGrabCheckChanged"
                                              Unchecked="OnWorldGrabCheckChanged" />
                                </WrapPanel>

                                <Border Background="#122136" BorderBrush="#1E3A5F" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,10">
                                    <TextBlock Text="💡 VR 手柄拖拽方法：将手柄射线指向（或直接伸手靠近）歌词面板，出现蓝色高亮边框后按住【侧握键 Grip】或【扳机键 Trigger】即可自由拖动位置，推手柄摇杆可调节远近，松开后自动保存坐标。游戏中若防止误触可关闭上方开关。"
                                               FontSize="12"
                                               Foreground="#BAE6FD"
                                               TextWrapping="Wrap" />
                                </Border>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="175" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="30" />
                                        <RowDefinition Height="30" />
                                        <RowDefinition Height="30" />
                                        <RowDefinition Height="30" />
                                        <RowDefinition Height="30" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="空间左右位置 (World X)" VerticalAlignment="Center" />
                                    <Slider x:Name="SldWorldX" Grid.Row="0" Grid.Column="1" Minimum="-3.00" Maximum="3.00" ValueChanged="OnPlacementSliderChanged" />
                                    <TextBlock x:Name="LblWorldX" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#CBD5E1" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="空间高度位置 (World Y)" VerticalAlignment="Center" />
                                    <Slider x:Name="SldWorldY" Grid.Row="1" Grid.Column="1" Minimum="0.20" Maximum="2.80" ValueChanged="OnPlacementSliderChanged" />
                                    <TextBlock x:Name="LblWorldY" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#CBD5E1" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="空间前后位置 (World Z)" VerticalAlignment="Center" />
                                    <Slider x:Name="SldWorldZ" Grid.Row="2" Grid.Column="1" Minimum="-3.50" Maximum="3.50" ValueChanged="OnPlacementSliderChanged" />
                                    <TextBlock x:Name="LblWorldZ" Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#CBD5E1" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="水平朝向偏航角 (Yaw °)" VerticalAlignment="Center" />
                                    <Slider x:Name="SldWorldYaw" Grid.Row="3" Grid.Column="1" Minimum="-180" Maximum="180" ValueChanged="OnPlacementSliderChanged" />
                                    <TextBlock x:Name="LblWorldYaw" Grid.Row="3" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#CBD5E1" />

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="空间俯仰倾角 (Pitch °)" VerticalAlignment="Center" />
                                    <Slider x:Name="SldWorldPitch" Grid.Row="4" Grid.Column="1" Minimum="-75" Maximum="75" ValueChanged="OnPlacementSliderChanged" />
                                    <TextBlock x:Name="LblWorldPitch" Grid.Row="4" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#CBD5E1" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- (C) 左右手腕跟随专属参数面板 -->
                        <Border x:Name="PanelHandMode"
                                Background="#0E1525"
                                BorderBrush="#24324D"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14,12"
                                Visibility="Collapsed">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <TextBlock x:Name="LblHandModeTitle" Text="⌚ 手腕 / 手柄跟随位置与角度" FontSize="13.5" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="🎮 手柄正上方 (默认)" Tag="ControllerTop" Style="{StaticResource ActionButtonStyle}" Padding="10,3" Margin="0,0,6,0" Click="OnHandPresetClick" />
                                        <Button Content="⌚ 手腕内侧 (看表姿势)" Tag="InnerWrist" Style="{StaticResource ActionButtonStyle}" Padding="10,3" Margin="0,0,6,0" Click="OnHandPresetClick" />
                                        <Button Content="🤚 手背外侧" Tag="OuterWrist" Style="{StaticResource ActionButtonStyle}" Padding="10,3" Click="OnHandPresetClick" />
                                    </StackPanel>
                                </DockPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="175" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="29" />
                                        <RowDefinition Height="29" />
                                        <RowDefinition Height="29" />
                                        <RowDefinition Height="29" />
                                        <RowDefinition Height="29" />
                                        <RowDefinition Height="29" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="手柄左右偏移 (Hand X)" VerticalAlignment="Center" />
                                    <Slider x:Name="SldHandX" Grid.Row="0" Grid.Column="1" Minimum="-0.35" Maximum="0.35" ValueChanged="OnPlacementSliderChanged" />
                                    <TextBlock x:Name="LblHandX" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#CBD5E1" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="手柄上下偏移 (Hand Y)" VerticalAlignment="Center" />
                                    <Slider x:Name="SldHandY" Grid.Row="1" Grid.Column="1" Minimum="-0.35" Maximum="0.35" ValueChanged="OnPlacementSliderChanged" />
                                    <TextBlock x:Name="LblHandY" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#CBD5E1" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="手柄前后偏移 (Hand Z)" VerticalAlignment="Center" />
                                    <Slider x:Name="SldHandZ" Grid.Row="2" Grid.Column="1" Minimum="-0.35" Maximum="0.35" ValueChanged="OnPlacementSliderChanged" />
                                    <TextBlock x:Name="LblHandZ" Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#CBD5E1" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="俯仰角度 (Pitch °)" VerticalAlignment="Center" />
                                    <Slider x:Name="SldHandPitch" Grid.Row="3" Grid.Column="1" Minimum="-180" Maximum="180" ValueChanged="OnPlacementSliderChanged" />
                                    <TextBlock x:Name="LblHandPitch" Grid.Row="3" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#CBD5E1" />

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="水平偏航角 (Yaw °)" VerticalAlignment="Center" />
                                    <Slider x:Name="SldHandYaw" Grid.Row="4" Grid.Column="1" Minimum="-180" Maximum="180" ValueChanged="OnPlacementSliderChanged" />
                                    <TextBlock x:Name="LblHandYaw" Grid.Row="4" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#CBD5E1" />

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="手腕翻滚角 (Roll °)" VerticalAlignment="Center" />
                                    <Slider x:Name="SldHandRoll" Grid.Row="5" Grid.Column="1" Minimum="-180" Maximum="180" ValueChanged="OnPlacementSliderChanged" />
                                    <TextBlock x:Name="LblHandRoll" Grid.Row="5" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#CBD5E1" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: 字体与排版 -->
            <TabItem Header="🔤 字体与排版">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,4,10,4">
                    <StackPanel>
                        <TextBlock Text="字体与字重" FontSize="14" FontWeight="Bold" Foreground="#38BDF8" Margin="0,2,0,10" />
                        <WrapPanel Margin="0,0,0,16" VerticalAlignment="Center">
                            <TextBlock Text="歌词字体：" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox x:Name="CmbFontFamily"
                                      Width="280"
                                      IsEditable="True"
                                      Margin="0,0,20,0"
                                      SelectionChanged="OnFontFamilySelectionChanged"
                                      LostFocus="OnFontFamilyLostFocus" />
                            <CheckBox x:Name="ChkBold"
                                      Content="粗体字重 (Bold，VR 远距离更清晰)"
                                      Checked="OnTypographyCheckChanged"
                                      Unchecked="OnTypographyCheckChanged" />
                        </WrapPanel>

                        <TextBlock Text="各级歌词字号" FontSize="14" FontWeight="Bold" Foreground="#38BDF8" Margin="0,4,0,8" />
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="85" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="36" />
                                <RowDefinition Height="36" />
                                <RowDefinition Height="36" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="当前主歌词字号 (px)" VerticalAlignment="Center" />
                            <Slider x:Name="SldMainFontSize" Grid.Row="0" Grid.Column="1" Minimum="28" Maximum="84" SmallChange="1" LargeChange="4" ValueChanged="OnTypographySliderChanged" />
                            <TextBlock x:Name="LblMainFontSize" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#7DD3FC" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="双语翻译行字号 (px)" VerticalAlignment="Center" />
                            <Slider x:Name="SldTransFontSize" Grid.Row="1" Grid.Column="1" Minimum="16" Maximum="54" SmallChange="1" LargeChange="4" ValueChanged="OnTypographySliderChanged" />
                            <TextBlock x:Name="LblTransFontSize" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#7DD3FC" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="上下句上下文行字号 (px)" VerticalAlignment="Center" />
                            <Slider x:Name="SldContextFontSize" Grid.Row="2" Grid.Column="1" Minimum="16" Maximum="54" SmallChange="1" LargeChange="4" ValueChanged="OnTypographySliderChanged" />
                            <TextBlock x:Name="LblContextFontSize" Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#7DD3FC" />
                        </Grid>

                        <TextBlock Text="显示内容开关" FontSize="14" FontWeight="Bold" Foreground="#38BDF8" Margin="0,4,0,8" />
                        <StackPanel>
                            <CheckBox x:Name="ChkShowTranslation" Content="显示双语翻译行（当歌曲包含中文/外文翻译时自动展示）" Checked="OnTypographyCheckChanged" Unchecked="OnTypographyCheckChanged" />
                            <CheckBox x:Name="ChkShowContextLines" Content="显示上一句与下一句上下文歌词" Checked="OnTypographyCheckChanged" Unchecked="OnTypographyCheckChanged" />
                            <CheckBox x:Name="ChkShowTrackHeader" Content="显示顶部歌曲与歌手标题栏" Checked="OnTypographyCheckChanged" Unchecked="OnTypographyCheckChanged" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 3: 色彩与动效 -->
            <TabItem Header="🎨 色彩与动效">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,4,10,4">
                    <StackPanel>
                        <TextBlock Text="一键主题配色预设" FontSize="14" FontWeight="Bold" Foreground="#38BDF8" Margin="0,2,0,8" />
                        <WrapPanel x:Name="PresetButtonsPanel" Margin="0,0,0,14" />

                        <TextBlock Text="卡拉OK与切行动效" FontSize="14" FontWeight="Bold" Foreground="#38BDF8" Margin="0,2,0,8" />
                        <WrapPanel Margin="0,0,0,8">
                            <CheckBox x:Name="ChkKaraokeHighlight" Content="逐字渐变擦除高亮 (YRC)" Margin="0,0,22,0" Checked="OnAnimationCheckChanged" Unchecked="OnAnimationCheckChanged" />
                            <CheckBox x:Name="ChkWordLift" Content="正在唱的单字韵律上浮" Margin="0,0,22,0" Checked="OnAnimationCheckChanged" Unchecked="OnAnimationCheckChanged" />
                            <CheckBox x:Name="ChkLineTransition" Content="切行平滑滚动与缩放过渡" Checked="OnAnimationCheckChanged" Unchecked="OnAnimationCheckChanged" />
                        </WrapPanel>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="85" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="32" />
                                <RowDefinition Height="32" />
                                <RowDefinition Height="32" />
                                <RowDefinition Height="32" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="切行动画时长 (ms)" VerticalAlignment="Center" />
                            <Slider x:Name="SldTransitionMs" Grid.Row="0" Grid.Column="1" Minimum="60" Maximum="480" ValueChanged="OnEffectsSliderChanged" />
                            <TextBlock x:Name="LblTransitionMs" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#CBD5E1" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="文字描边粗细 (px)" VerticalAlignment="Center" />
                            <Slider x:Name="SldStrokeWidth" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="12" SmallChange="0.5" ValueChanged="OnEffectsSliderChanged" />
                            <TextBlock x:Name="LblStrokeWidth" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#CBD5E1" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="投影模糊半径 (px)" VerticalAlignment="Center" />
                            <Slider x:Name="SldShadowBlur" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="20" SmallChange="0.5" ValueChanged="OnEffectsSliderChanged" />
                            <TextBlock x:Name="LblShadowBlur" Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#CBD5E1" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="底板圆角半径 (px)" VerticalAlignment="Center" />
                            <Slider x:Name="SldCornerRadius" Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="48" SmallChange="1" ValueChanged="OnEffectsSliderChanged" />
                            <TextBlock x:Name="LblCornerRadius" Grid.Row="3" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#CBD5E1" />
                        </Grid>

                        <TextBlock Text="自定义颜色 (#AARRGGBB 或点击色块取色)" FontSize="14" FontWeight="Bold" Foreground="#38BDF8" Margin="0,2,0,8" />
                        <UniformGrid Columns="3">
                            <!-- Sung Top -->
                            <StackPanel Orientation="Horizontal" Margin="0,4,12,4">
                                <TextBlock Text="已唱顶部色" Width="80" VerticalAlignment="Center" />
                                <Button x:Name="BtnColorSungTop" Width="28" Height="26" Margin="0,0,6,0" Tag="SungTop" Click="OnColorSwatchClick" />
                                <TextBox x:Name="TxtColorSungTop" Width="100" Style="{StaticResource DarkTextBoxStyle}" Tag="SungTop" LostFocus="OnColorTextLostFocus" KeyDown="OnColorTextKeyDown" />
                            </StackPanel>

                            <!-- Sung Bottom -->
                            <StackPanel Orientation="Horizontal" Margin="0,4,12,4">
                                <TextBlock Text="已唱底部色" Width="80" VerticalAlignment="Center" />
                                <Button x:Name="BtnColorSungBottom" Width="28" Height="26" Margin="0,0,6,0" Tag="SungBottom" Click="OnColorSwatchClick" />
                                <TextBox x:Name="TxtColorSungBottom" Width="100" Style="{StaticResource DarkTextBoxStyle}" Tag="SungBottom" LostFocus="OnColorTextLostFocus" KeyDown="OnColorTextKeyDown" />
                            </StackPanel>

                            <!-- Sung Glow -->
                            <StackPanel Orientation="Horizontal" Margin="0,4,12,4">
                                <TextBlock Text="已唱发光色" Width="80" VerticalAlignment="Center" />
                                <Button x:Name="BtnColorSungGlow" Width="28" Height="26" Margin="0,0,6,0" Tag="SungGlow" Click="OnColorSwatchClick" />
                                <TextBox x:Name="TxtColorSungGlow" Width="100" Style="{StaticResource DarkTextBoxStyle}" Tag="SungGlow" LostFocus="OnColorTextLostFocus" KeyDown="OnColorTextKeyDown" />
                            </StackPanel>

                            <!-- Unsung Top -->
                            <StackPanel Orientation="Horizontal" Margin="0,4,12,4">
                                <TextBlock Text="未唱顶部色" Width="80" VerticalAlignment="Center" />
                                <Button x:Name="BtnColorUnsungTop" Width="28" Height="26" Margin="0,0,6,0" Tag="UnsungTop" Click="OnColorSwatchClick" />
                                <TextBox x:Name="TxtColorUnsungTop" Width="100" Style="{StaticResource DarkTextBoxStyle}" Tag="UnsungTop" LostFocus="OnColorTextLostFocus" KeyDown="OnColorTextKeyDown" />
                            </StackPanel>

                            <!-- Unsung Bottom -->
                            <StackPanel Orientation="Horizontal" Margin="0,4,12,4">
                                <TextBlock Text="未唱底部色" Width="80" VerticalAlignment="Center" />
                                <Button x:Name="BtnColorUnsungBottom" Width="28" Height="26" Margin="0,0,6,0" Tag="UnsungBottom" Click="OnColorSwatchClick" />
                                <TextBox x:Name="TxtColorUnsungBottom" Width="100" Style="{StaticResource DarkTextBoxStyle}" Tag="UnsungBottom" LostFocus="OnColorTextLostFocus" KeyDown="OnColorTextKeyDown" />
                            </StackPanel>

                            <!-- Translation -->
                            <StackPanel Orientation="Horizontal" Margin="0,4,12,4">
                                <TextBlock Text="翻译行颜色" Width="80" VerticalAlignment="Center" />
                                <Button x:Name="BtnColorTranslation" Width="28" Height="26" Margin="0,0,6,0" Tag="Translation" Click="OnColorSwatchClick" />
                                <TextBox x:Name="TxtColorTranslation" Width="100" Style="{StaticResource DarkTextBoxStyle}" Tag="Translation" LostFocus="OnColorTextLostFocus" KeyDown="OnColorTextKeyDown" />
                            </StackPanel>

                            <!-- Context -->
                            <StackPanel Orientation="Horizontal" Margin="0,4,12,4">
                                <TextBlock Text="上下文颜色" Width="80" VerticalAlignment="Center" />
                                <Button x:Name="BtnColorContext" Width="28" Height="26" Margin="0,0,6,0" Tag="Context" Click="OnColorSwatchClick" />
                                <TextBox x:Name="TxtColorContext" Width="100" Style="{StaticResource DarkTextBoxStyle}" Tag="Context" LostFocus="OnColorTextLostFocus" KeyDown="OnColorTextKeyDown" />
                            </StackPanel>

                            <!-- Stroke -->
                            <StackPanel Orientation="Horizontal" Margin="0,4,12,4">
                                <TextBlock Text="文字描边色" Width="80" VerticalAlignment="Center" />
                                <Button x:Name="BtnColorStroke" Width="28" Height="26" Margin="0,0,6,0" Tag="Stroke" Click="OnColorSwatchClick" />
                                <TextBox x:Name="TxtColorStroke" Width="100" Style="{StaticResource DarkTextBoxStyle}" Tag="Stroke" LostFocus="OnColorTextLostFocus" KeyDown="OnColorTextKeyDown" />
                            </StackPanel>

                            <!-- Background -->
                            <StackPanel Orientation="Horizontal" Margin="0,4,12,4">
                                <TextBlock Text="背景底板色" Width="80" VerticalAlignment="Center" />
                                <Button x:Name="BtnColorBackground" Width="28" Height="26" Margin="0,0,6,0" Tag="Background" Click="OnColorSwatchClick" />
                                <TextBox x:Name="TxtColorBackground" Width="100" Style="{StaticResource DarkTextBoxStyle}" Tag="Background" LostFocus="OnColorTextLostFocus" KeyDown="OnColorTextKeyDown" />
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 4: 时间轴与系统集成 -->
            <TabItem Header="⏱️ 时间轴与系统集成">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,4,10,4">
                    <StackPanel>
                        <TextBlock Text="全局歌词时间偏移调节" FontSize="14" FontWeight="Bold" Foreground="#38BDF8" Margin="0,2,0,6" />
                        <TextBlock Text="当播放器蓝牙/无线串流存在音频延迟时，可通过偏移微调让歌词与声音完全同步（正值 = 歌词提前出现；负值 = 歌词延后出现）。"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="12"
                                   Margin="0,0,0,8" />

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="全局时间偏移 (ms)" VerticalAlignment="Center" />
                            <Slider x:Name="SldGlobalOffset" Grid.Column="1" Minimum="-5000" Maximum="5000" SmallChange="50" LargeChange="200" ValueChanged="OnGlobalOffsetSliderChanged" />
                            <TextBlock x:Name="LblGlobalOffset" Grid.Column="2" Text="+0 ms (0.00s)" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#7DD3FC" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Button Content="-500 ms" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0" Tag="-500" Click="OnOffsetStepClick" />
                            <Button Content="-100 ms" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0" Tag="-100" Click="OnOffsetStepClick" />
                            <Button Content="重置全局 0 ms" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0" Tag="0" Click="OnOffsetResetClick" />
                            <Button Content="+100 ms" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0" Tag="100" Click="OnOffsetStepClick" />
                            <Button Content="+500 ms" Style="{StaticResource ActionButtonStyle}" Tag="500" Click="OnOffsetStepClick" />
                        </StackPanel>

                        <DockPanel Margin="0,2,0,6">
                            <TextBlock Text="单曲专属时间偏移（自动按歌曲记忆）" FontSize="14" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center" />
                            <TextBlock x:Name="LblTrackOffsetTarget" Text="当前曲目：未在播放" Foreground="{StaticResource MutedTextBrush}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </DockPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="当前单曲偏移 (ms)" VerticalAlignment="Center" />
                            <Slider x:Name="SldTrackOffset" Grid.Column="1" Minimum="-5000" Maximum="5000" SmallChange="50" LargeChange="200" ValueChanged="OnTrackOffsetSliderChanged" />
                            <TextBlock x:Name="LblTrackOffset" Grid.Column="2" Text="+0 ms (0.00s)" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#7DD3FC" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Button Content="-200 ms" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0" Tag="-200" Click="OnTrackOffsetStepClick" />
                            <Button Content="-50 ms" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0" Tag="-50" Click="OnTrackOffsetStepClick" />
                            <Button Content="重置单曲 0 ms" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0" Tag="0" Click="OnTrackOffsetResetClick" />
                            <Button Content="+50 ms" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0" Tag="50" Click="OnTrackOffsetStepClick" />
                            <Button Content="+200 ms" Style="{StaticResource ActionButtonStyle}" Tag="200" Click="OnTrackOffsetStepClick" />
                        </StackPanel>

                        <TextBlock Text="歌词源优先级偏好（支持在 SteamVR Dashboard 内一键切换）" FontSize="14" FontWeight="Bold" Foreground="#38BDF8" Margin="0,2,0,6" />
                        <WrapPanel Margin="0,0,0,14">
                            <RadioButton x:Name="RbSourceAuto" Content="⚡ 自动优选 (Auto)" GroupName="LyricsSource" Margin="0,0,20,6" Checked="OnLyricsSourceRadioChecked" />
                            <RadioButton x:Name="RbSourceNetEase" Content="🎵 网易云音乐 (YRC逐字/双语)" GroupName="LyricsSource" Margin="0,0,20,6" Checked="OnLyricsSourceRadioChecked" />
                            <RadioButton x:Name="RbSourceQqMusic" Content="🎶 QQ音乐 (LRC/双语)" GroupName="LyricsSource" Margin="0,0,20,6" Checked="OnLyricsSourceRadioChecked" />
                            <RadioButton x:Name="RbSourceLrclib" Content="🌐 LRCLIB 国际曲库" GroupName="LyricsSource" Margin="0,0,20,6" Checked="OnLyricsSourceRadioChecked" />
                            <RadioButton x:Name="RbSourceLocal" Content="📁 本地 .lrc 目录优先" GroupName="LyricsSource" Margin="0,0,10,6" Checked="OnLyricsSourceRadioChecked" />
                        </WrapPanel>

                        <TextBlock Text="本地 .lrc 歌词搜索目录" FontSize="14" FontWeight="Bold" Foreground="#38BDF8" Margin="0,2,0,6" />
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ListBox x:Name="LstLocalFolders"
                                     Grid.Column="0"
                                     Height="68"
                                     Background="#0D1322"
                                     Foreground="#E2E8F0"
                                     BorderBrush="#334155"
                                     Margin="0,0,12,0" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                <Button Content="➕ 添加文件夹…" Style="{StaticResource ActionButtonStyle}" Margin="0,0,0,8" Click="OnAddLocalFolderClick" />
                                <Button Content="➖ 移除选中项" Style="{StaticResource ActionButtonStyle}" Click="OnRemoveLocalFolderClick" />
                            </StackPanel>
                        </Grid>

                        <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="🚀 SteamVR 自动启动与应用清单注册 (vrmanifest)" FontSize="14" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,6" />
                                <WrapPanel Margin="0,0,0,6">
                                    <CheckBox x:Name="ChkAutoStartWithSteamVr"
                                              Content="随 SteamVR 启动自动运行 VRLyrics（自动最小化到系统托盘）"
                                              Margin="0,0,24,4"
                                              Checked="OnSteamVrLifecycleCheckChanged"
                                              Unchecked="OnSteamVrLifecycleCheckChanged" />
                                    <CheckBox x:Name="ChkExitWithSteamVr"
                                              Content="当 SteamVR 退出时自动关闭 VRLyrics"
                                              Margin="0,0,0,4"
                                              Checked="OnSteamVrLifecycleCheckChanged"
                                              Unchecked="OnSteamVrLifecycleCheckChanged" />
                                </WrapPanel>
                                <TextBlock x:Name="TxtManifestStatus" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,0,0,8" TextWrapping="Wrap" />
                                <WrapPanel>
                                    <Button Content="📝 立即注册/刷新 vrmanifest" Style="{StaticResource ActionButtonStyle}" Margin="0,0,10,0" Click="OnRegisterManifestClick" />
                                    <Button Content="🗑️ 从 SteamVR 移除注册" Style="{StaticResource ActionButtonStyle}" Click="OnUnregisterManifestClick" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="配置存储与维护" FontSize="14" FontWeight="Bold" Foreground="#38BDF8" Margin="0,2,0,6" />
                        <TextBlock x:Name="TxtSettingsFilePath" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,0,0,8" />
                        <WrapPanel>
                            <Button Content="📂 打开配置与缓存目录" Style="{StaticResource ActionButtonStyle}" Margin="0,0,10,0" Click="OnOpenConfigFolderClick" />
                            <Button Content="🔄 忽略缓存重新拉取当前歌词" Style="{StaticResource ActionButtonStyle}" Margin="0,0,10,0" Click="OnReloadLyricsClick" />
                            <Button Content="⚠️ 恢复全部默认设置" Style="{StaticResource DangerButtonStyle}" Click="OnResetAllSettingsClick" />
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
