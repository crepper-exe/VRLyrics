                        </StackPanel>

                        <Border Style="{StaticResource SettingsCardBorderStyle}">
                            <DockPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="歌词渲染字体 (Font Family)" Style="{StaticResource CardTitleText}" />
                                    <TextBlock Text="可从本机已安装字体中选择，或直接输入字体名称" Style="{StaticResource CardDescText}" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <ComboBox x:Name="CmbFontFamily"
                                              Width="260"
                                              Height="34"
                                              IsEditable="True"
                                              VerticalContentAlignment="Center"
                                              Margin="0,0,24,0"
                                              SelectionChanged="OnFontFamilySelectionChanged"
                                              LostFocus="OnFontFamilyLostFocus" />
                                    <CheckBox x:Name="ChkBold"
                                              Content="粗体字重 (Bold)"
                                              Checked="OnTypographyCheckChanged"
                                              Unchecked="OnTypographyCheckChanged" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="三级字号比例" Style="{StaticResource CardTitleText}" Margin="0,0,0,14" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="44" />
                                        <RowDefinition Height="44" />
                                        <RowDefinition Height="44" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="当前主歌词字号" Style="{StaticResource FieldLabelText}" />
                                    <Slider x:Name="SldMainFontSize" Grid.Row="0" Grid.Column="1" Minimum="28" Maximum="84" SmallChange="1" LargeChange="4" ValueChanged="OnTypographySliderChanged" />
                                    <TextBlock x:Name="LblMainFontSize" Grid.Row="0" Grid.Column="2" Text="52 px" Style="{StaticResource ValueText}" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="双语翻译行字号" Style="{StaticResource FieldLabelText}" />
                                    <Slider x:Name="SldTransFontSize" Grid.Row="1" Grid.Column="1" Minimum="18" Maximum="56" SmallChange="1" LargeChange="4" ValueChanged="OnTypographySliderChanged" />
                                    <TextBlock x:Name="LblTransFontSize" Grid.Row="1" Grid.Column="2" Text="30 px" Style="{StaticResource ValueText}" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="上下句预览字号" Style="{StaticResource FieldLabelText}" />
                                    <Slider x:Name="SldContextFontSize" Grid.Row="2" Grid.Column="1" Minimum="18" Maximum="56" SmallChange="1" LargeChange="4" ValueChanged="OnTypographySliderChanged" />
                                    <TextBlock x:Name="LblContextFontSize" Grid.Row="2" Grid.Column="2" Text="32 px" Style="{StaticResource ValueText}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCardBorderStyle}">
                            <StackPanel>
                                <DockPanel>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="显示双语翻译行" Style="{StaticResource CardTitleText}" FontSize="14" />
                                        <TextBlock Text="当外语歌曲包含中文翻译时，在主歌词正下方同步渲染译文" Style="{StaticResource CardDescText}" />
                                    </StackPanel>
                                    <CheckBox x:Name="ChkShowTranslation" HorizontalAlignment="Right" Checked="OnTypographyCheckChanged" Unchecked="OnTypographyCheckChanged" />
                                </DockPanel>

                                <Border Style="{StaticResource RowDivider}" />

                                <DockPanel>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="显示上一句 / 下一句上下文歌词" Style="{StaticResource CardTitleText}" FontSize="14" />
                                        <TextBlock Text="在主歌词上下方半透明预览相邻歌词行，提前预知下一句唱词" Style="{StaticResource CardDescText}" />
                                    </StackPanel>
                                    <CheckBox x:Name="ChkShowContextLines" HorizontalAlignment="Right" Checked="OnTypographyCheckChanged" Unchecked="OnTypographyCheckChanged" />
                                </DockPanel>

                                <Border Style="{StaticResource RowDivider}" />

                                <DockPanel>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="显示顶部歌曲名与播放进度" Style="{StaticResource CardTitleText}" FontSize="14" />
                                        <TextBlock Text="在叠加层顶部展示当前歌名、歌手及播放时间" Style="{StaticResource CardDescText}" />
                                    </StackPanel>
                                    <CheckBox x:Name="ChkShowTrackHeader" HorizontalAlignment="Right" Checked="OnTypographyCheckChanged" Unchecked="OnTypographyCheckChanged" />
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ==================== PAGE 3: 色彩主题与动效 ==================== -->
                    <StackPanel x:Name="PageColors" Visibility="Collapsed">
                        <StackPanel Margin="2,0,2,20">
                            <TextBlock Text="色彩主题与动效" Style="{StaticResource PageTitleText}" />
                            <TextBlock Text="一键切换精选卡拉OK配色方案，或点击色块精细定制每一处歌词色彩与光效" Style="{StaticResource PageDescText}" />
                        </StackPanel>

                        <Border Style="{StaticResource SettingsCardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="预设配色方案" Style="{StaticResource CardTitleText}" Margin="0,0,0,14" />
                                <WrapPanel x:Name="PresetButtonsPanel" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="卡拉OK动效与描边阴影" Style="{StaticResource CardTitleText}" Margin="0,0,0,14" />
                                <WrapPanel>
                                    <CheckBox x:Name="ChkKaraokeHighlight" Content="逐字渐变擦除高亮" Margin="0,0,36,4" Checked="OnAnimationCheckChanged" Unchecked="OnAnimationCheckChanged" />
                                    <CheckBox x:Name="ChkWordLift" Content="正在演唱单字微抬律动" Margin="0,0,36,4" Checked="OnAnimationCheckChanged" Unchecked="OnAnimationCheckChanged" />
                                    <CheckBox x:Name="ChkLineTransition" Content="切行平滑上滑缩放动画" Margin="0,0,0,4" Checked="OnAnimationCheckChanged" Unchecked="OnAnimationCheckChanged" />
                                </WrapPanel>

                                <Border Style="{StaticResource RowDivider}" Margin="0,16,0,12" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="42" />
                                        <RowDefinition Height="42" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" Grid.Column="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="148" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="72" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="切行过渡时长" Style="{StaticResource FieldLabelText}" />
                                        <Slider x:Name="SldTransitionMs" Grid.Column="1" Minimum="60" Maximum="500" SmallChange="10" LargeChange="40" ValueChanged="OnEffectsSliderChanged" />
                                        <TextBlock x:Name="LblTransitionMs" Grid.Column="2" Text="220 ms" Style="{StaticResource ValueText}" />
                                    </Grid>

                                    <Grid Grid.Row="0" Grid.Column="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="148" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="72" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="文字抗干扰描边" Style="{StaticResource FieldLabelText}" />
                                        <Slider x:Name="SldStrokeWidth" Grid.Column="1" Minimum="0" Maximum="12" SmallChange="0.5" LargeChange="1" ValueChanged="OnEffectsSliderChanged" />
                                        <TextBlock x:Name="LblStrokeWidth" Grid.Column="2" Text="5.5 px" Style="{StaticResource ValueText}" />
                                    </Grid>

                                    <Grid Grid.Row="1" Grid.Column="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="148" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="72" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="发光与阴影半径" Style="{StaticResource FieldLabelText}" />
                                        <Slider x:Name="SldShadowBlur" Grid.Column="1" Minimum="0" Maximum="20" SmallChange="0.5" LargeChange="2" ValueChanged="OnEffectsSliderChanged" />
                                        <TextBlock x:Name="LblShadowBlur" Grid.Column="2" Text="8.0 px" Style="{StaticResource ValueText}" />
                                    </Grid>

                                    <Grid Grid.Row="1" Grid.Column="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="148" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="72" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="背景底板圆角" Style="{StaticResource FieldLabelText}" />
                                        <Slider x:Name="SldCornerRadius" Grid.Column="1" Minimum="0" Maximum="60" SmallChange="2" LargeChange="8" ValueChanged="OnEffectsSliderChanged" />
                                        <TextBlock x:Name="LblCornerRadius" Grid.Column="2" Text="26 px" Style="{StaticResource ValueText}" />
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCardBorderStyle}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <TextBlock Text="精细颜色自定义" Style="{StaticResource CardTitleText}" />
                                    <TextBlock Text="点击色块打开调色器（支持 RGBA 调节与 #AARRGGBB 色号输入）"
                                               FontSize="12"
                                               Foreground="{StaticResource Text3Brush}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center" />
                                </DockPanel>

                                <UniformGrid Columns="3">
                                    <StackPanel Orientation="Horizontal" Margin="0,5,24,5">
                                        <TextBlock Text="已唱渐变 (上)" Width="96" Style="{StaticResource FieldLabelText}" VerticalAlignment="Center" />
                                        <Button x:Name="BtnColorSungTop" Style="{StaticResource SwatchButtonStyle}" Width="48" Height="28" Tag="SungTop" Click="OnColorSwatchClick" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,5,24,5">
                                        <TextBlock Text="已唱渐变 (下)" Width="96" Style="{StaticResource FieldLabelText}" VerticalAlignment="Center" />
                                        <Button x:Name="BtnColorSungBottom" Style="{StaticResource SwatchButtonStyle}" Width="48" Height="28" Tag="SungBottom" Click="OnColorSwatchClick" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,5">
                                        <TextBlock Text="已唱外发光" Width="96" Style="{StaticResource FieldLabelText}" VerticalAlignment="Center" />
                                        <Button x:Name="BtnColorSungGlow" Style="{StaticResource SwatchButtonStyle}" Width="48" Height="28" Tag="SungGlow" Click="OnColorSwatchClick" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,5,24,5">
                                        <TextBlock Text="未唱渐变 (上)" Width="96" Style="{StaticResource FieldLabelText}" VerticalAlignment="Center" />
                                        <Button x:Name="BtnColorUnsungTop" Style="{StaticResource SwatchButtonStyle}" Width="48" Height="28" Tag="UnsungTop" Click="OnColorSwatchClick" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,5,24,5">
                                        <TextBlock Text="未唱渐变 (下)" Width="96" Style="{StaticResource FieldLabelText}" VerticalAlignment="Center" />
                                        <Button x:Name="BtnColorUnsungBottom" Style="{StaticResource SwatchButtonStyle}" Width="48" Height="28" Tag="UnsungBottom" Click="OnColorSwatchClick" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,5">
                                        <TextBlock Text="双语翻译色" Width="96" Style="{StaticResource FieldLabelText}" VerticalAlignment="Center" />
                                        <Button x:Name="BtnColorTranslation" Style="{StaticResource SwatchButtonStyle}" Width="48" Height="28" Tag="Translation" Click="OnColorSwatchClick" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,5,24,5">
                                        <TextBlock Text="上下文行色" Width="96" Style="{StaticResource FieldLabelText}" VerticalAlignment="Center" />
                                        <Button x:Name="BtnColorContext" Style="{StaticResource SwatchButtonStyle}" Width="48" Height="28" Tag="Context" Click="OnColorSwatchClick" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,5,24,5">
                                        <TextBlock Text="文字描边色" Width="96" Style="{StaticResource FieldLabelText}" VerticalAlignment="Center" />
                                        <Button x:Name="BtnColorStroke" Style="{StaticResource SwatchButtonStyle}" Width="48" Height="28" Tag="Stroke" Click="OnColorSwatchClick" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,5">
                                        <TextBlock Text="背景底板色" Width="96" Style="{StaticResource FieldLabelText}" VerticalAlignment="Center" />
                                        <Button x:Name="BtnColorBackground" Style="{StaticResource SwatchButtonStyle}" Width="48" Height="28" Tag="Background" Click="OnColorSwatchClick" />
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ==================== PAGE 4: 时间轴与系统集成 ==================== -->
                    <StackPanel x:Name="PageSystem" Visibility="Collapsed">
                        <StackPanel Margin="2,0,2,20">
                            <TextBlock Text="时间轴与系统集成" Style="{StaticResource PageTitleText}" />
                            <TextBlock Text="微调全局与单曲时间轴偏移、切换歌词源优先级，以及管理随 SteamVR 自动启动" Style="{StaticResource PageDescText}" />
                        </StackPanel>

                        <!-- Combined Global & Per-Track Offset Card -->
                        <Border Style="{StaticResource SettingsCardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="全局与单曲歌词时间偏移" Style="{StaticResource CardTitleText}" />
                                <TextBlock Text="补偿蓝牙耳机或无线串流延迟（正值 = 歌词提前出现；负值 = 歌词延后出现）" Style="{StaticResource CardDescText}" Margin="0,4,0,14" />

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="165" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="125" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="全局时间偏移 (Global)" Style="{StaticResource FieldLabelText}" />
                                    <Slider x:Name="SldGlobalOffset" Grid.Column="1" Minimum="-5000" Maximum="5000" SmallChange="50" LargeChange="200" ValueChanged="OnGlobalOffsetSliderChanged" />
                                    <TextBlock x:Name="LblGlobalOffset" Grid.Column="2" Text="+0 ms (0.00s)" Style="{StaticResource ValueText}" />
                                </Grid>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="-500 ms" Style="{StaticResource ActionButtonStyle}" Margin="0,0,10,0" Tag="-500" Click="OnOffsetStepClick" />
                                    <Button Content="-100 ms" Style="{StaticResource ActionButtonStyle}" Margin="0,0,10,0" Tag="-100" Click="OnOffsetStepClick" />
                                    <Button Content="重置全局 0 ms" Style="{StaticResource ActionButtonStyle}" Margin="0,0,10,0" Tag="0" Click="OnOffsetResetClick" />
                                    <Button Content="+100 ms" Style="{StaticResource ActionButtonStyle}" Margin="0,0,10,0" Tag="100" Click="OnOffsetStepClick" />
                                    <Button Content="+500 ms" Style="{StaticResource ActionButtonStyle}" Tag="500" Click="OnOffsetStepClick" />
                                </StackPanel>

                                <Border Style="{StaticResource RowDivider}" Margin="0,18,0,16" />

                                <DockPanel Margin="0,0,0,10">
                                    <TextBlock Text="单曲专属偏移（按歌曲自动永久记忆）" FontSize="14" FontWeight="Medium" Foreground="{StaticResource Text1Brush}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="LblTrackOffsetTarget" Text="当前曲目：未在播放" Foreground="{StaticResource Text3Brush}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </DockPanel>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="165" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="125" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="当前单曲偏移 (Track)" Style="{StaticResource FieldLabelText}" />
                                    <Slider x:Name="SldTrackOffset" Grid.Column="1" Minimum="-5000" Maximum="5000" SmallChange="50" LargeChange="200" ValueChanged="OnTrackOffsetSliderChanged" />
                                    <TextBlock x:Name="LblTrackOffset" Grid.Column="2" Text="+0 ms (0.00s)" Style="{StaticResource ValueText}" />
                                </Grid>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="-200 ms" Style="{StaticResource ActionButtonStyle}" Margin="0,0,10,0" Tag="-200" Click="OnTrackOffsetStepClick" />
                                    <Button Content="-50 ms" Style="{StaticResource ActionButtonStyle}" Margin="0,0,10,0" Tag="-50" Click="OnTrackOffsetStepClick" />
                                    <Button Content="重置单曲 0 ms" Style="{StaticResource ActionButtonStyle}" Margin="0,0,10,0" Tag="0" Click="OnTrackOffsetResetClick" />
                                    <Button Content="+50 ms" Style="{StaticResource ActionButtonStyle}" Margin="0,0,10,0" Tag="50" Click="OnTrackOffsetStepClick" />
                                    <Button Content="+200 ms" Style="{StaticResource ActionButtonStyle}" Tag="200" Click="OnTrackOffsetStepClick" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Lyrics Provider Segmented Selector & Local Folders Card -->
                        <Border Style="{StaticResource SettingsCardBorderStyle}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,14">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="未捕获到播放活动 5 秒后自动隐藏歌词" FontSize="13.5" FontWeight="Medium" Foreground="{StaticResource Text1Brush}" />
                                        <TextBlock Text="当音乐暂停、停止或未检测到播放器满 5 秒时自动隐藏 VR 歌词叠加层，恢复播放时立即唤醒显示" FontSize="12" Foreground="{StaticResource Text3Brush}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <CheckBox x:Name="ChkAutoHideWhenIdle"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center"
                                              Checked="OnAutoHideWhenIdleChanged"
                                              Unchecked="OnAutoHideWhenIdleChanged" />
                                </DockPanel>

                                <Border Style="{StaticResource RowDivider}" Margin="0,0,0,14" />

                                <DockPanel Margin="0,0,0,14">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="屏蔽来自浏览器的播放活动" FontSize="13.5" FontWeight="Medium" Foreground="{StaticResource Text1Brush}" />
                                        <TextBlock Text="忽略 Edge、Chrome、Firefox 等网页视频与直播声音，仅跟随独立音乐软件" FontSize="12" Foreground="{StaticResource Text3Brush}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <CheckBox x:Name="ChkIgnoreBrowserSessions"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center"
                                              Checked="OnIgnoreBrowserSessionsChanged"
                                              Unchecked="OnIgnoreBrowserSessionsChanged" />
                                </DockPanel>

                                <Border Style="{StaticResource RowDivider}" Margin="0,0,0,14" />

                                <DockPanel Margin="0,0,0,12">
                                    <TextBlock Text="歌词源优先级与本地词库" Style="{StaticResource CardTitleText}" />
                                    <TextBlock Text="与 SteamVR 仪表盘实时联动" FontSize="12" Foreground="{StaticResource Text3Brush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </DockPanel>

                                <Border Style="{StaticResource SegmentedTrackStyle}" Margin="0,0,0,16">
                                    <UniformGrid Columns="5">
                                        <RadioButton x:Name="RbSourceAuto" Style="{StaticResource SegmentedItemRadioStyle}" Content="自动优选 (Auto)" GroupName="LyricsSource" Checked="OnLyricsSourceRadioChecked" />
                                        <RadioButton x:Name="RbSourceNetEase" Style="{StaticResource SegmentedItemRadioStyle}" Content="网易云音乐" GroupName="LyricsSource" Checked="OnLyricsSourceRadioChecked" />
                                        <RadioButton x:Name="RbSourceQqMusic" Style="{StaticResource SegmentedItemRadioStyle}" Content="QQ 音乐" GroupName="LyricsSource" Checked="OnLyricsSourceRadioChecked" />
                                        <RadioButton x:Name="RbSourceLrclib" Style="{StaticResource SegmentedItemRadioStyle}" Content="LRCLIB" GroupName="LyricsSource" Checked="OnLyricsSourceRadioChecked" />
                                        <RadioButton x:Name="RbSourceLocal" Style="{StaticResource SegmentedItemRadioStyle}" Content="本地 .lrc" GroupName="LyricsSource" Checked="OnLyricsSourceRadioChecked" />
                                    </UniformGrid>
                                </Border>

                                <TextBlock Text="本地 .lrc 歌词搜索目录" FontSize="13" FontWeight="Medium" Foreground="{StaticResource Text2Brush}" Margin="0,0,0,8" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ListBox x:Name="LstLocalFolders"
                                             Grid.Column="0"
                                             Height="74"
                                             Background="{StaticResource InsetBrush}"
                                             Foreground="{StaticResource Text1Brush}"
                                             BorderBrush="{StaticResource BorderBrush}"
                                             Margin="0,0,12,0" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                        <Button Content="添加文件夹…" Style="{StaticResource ActionButtonStyle}" Margin="0,0,0,8" Click="OnAddLocalFolderClick" />
                                        <Button Content="移除选中项" Style="{StaticResource ActionButtonStyle}" Click="OnRemoveLocalFolderClick" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- SteamVR Lifecycle & Maintenance Card -->
                        <Border Style="{StaticResource SettingsCardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="SteamVR 自动启动与系统维护" Style="{StaticResource CardTitleText}" Margin="0,0,0,14" />

                                <DockPanel Margin="0,0,0,12">
                                    <TextBlock Text="随 SteamVR 启动自动运行 VRLyrics（静默最小化到系统托盘）" Style="{StaticResource FieldLabelText}" Foreground="{StaticResource Text1Brush}" />
                                    <CheckBox x:Name="ChkAutoStartWithSteamVr" HorizontalAlignment="Right" Checked="OnSteamVrLifecycleCheckChanged" Unchecked="OnSteamVrLifecycleCheckChanged" />
                                </DockPanel>

                                <DockPanel Margin="0,0,0,14">
                                    <TextBlock Text="当 SteamVR 退出时自动关闭 VRLyrics" Style="{StaticResource FieldLabelText}" Foreground="{StaticResource Text1Brush}" />
                                    <CheckBox x:Name="ChkExitWithSteamVr" HorizontalAlignment="Right" Checked="OnSteamVrLifecycleCheckChanged" Unchecked="OnSteamVrLifecycleCheckChanged" />
                                </DockPanel>

                                <TextBlock x:Name="TxtManifestStatus" Foreground="{StaticResource Text3Brush}" FontSize="12" LineHeight="18" Margin="0,0,0,12" TextWrapping="Wrap" />

                                <WrapPanel>
                                    <Button Content="刷新 vrmanifest 注册" Style="{StaticResource ActionButtonStyle}" Margin="0,0,10,0" Click="OnRegisterManifestClick" />
                                    <Button Content="从 SteamVR 移除注册" Style="{StaticResource ActionButtonStyle}" Click="OnUnregisterManifestClick" />
                                </WrapPanel>

                                <Border Style="{StaticResource RowDivider}" Margin="0,18,0,14" />

                                <TextBlock x:Name="TxtSettingsFilePath" Foreground="{StaticResource Text3Brush}" FontSize="12" Margin="0,0,0,12" />
                                <WrapPanel>
                                    <Button Content="打开配置与缓存目录" Style="{StaticResource ActionButtonStyle}" Margin="0,0,10,0" Click="OnOpenConfigFolderClick" />
                                    <Button Content="忽略缓存重新拉取歌词" Style="{StaticResource ActionButtonStyle}" Margin="0,0,10,0" Click="OnReloadLyricsClick" />
                                    <Button Content="恢复全部默认设置" Style="{StaticResource DangerButtonStyle}" Click="OnResetAllSettingsClick" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                        </Grid>
                    </ScrollViewer>

                    <!-- Top & Bottom Soft Gradient Feather Overlays on Content Boundaries -->
                    <Border x:Name="TopScrollFadeMask"
                            Height="20"
                            VerticalAlignment="Top"
                            Margin="0,0,10,0"
                            IsHitTestVisible="False">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#FF141619" Offset="0.00" />
                                <GradientStop Color="#99141619" Offset="0.45" />
                                <GradientStop Color="#00141619" Offset="1.00" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <Border x:Name="BottomScrollFadeMask"
                            Height="52"
                            VerticalAlignment="Bottom"
                            Margin="0,0,10,0"
                            IsHitTestVisible="False">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00141619" Offset="0.00" />
                                <GradientStop Color="#66141619" Offset="0.42" />
                                <GradientStop Color="#E0141619" Offset="0.78" />
                                <GradientStop Color="#FF141619" Offset="0.95" />
                                <GradientStop Color="#FF141619" Offset="1.00" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
