                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="74" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="42" />
                                            <RowDefinition Height="42" />
                                            <RowDefinition Height="42" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="手部偏移 X" Style="{StaticResource FieldLabelText}" />
                                        <Slider x:Name="SldHandX" Grid.Row="0" Grid.Column="1" Minimum="-0.35" Maximum="0.35" SmallChange="0.01" LargeChange="0.05" ValueChanged="OnPlacementSliderChanged" />
                                        <TextBlock x:Name="LblHandX" Grid.Row="0" Grid.Column="2" Text="+0.00 m" Style="{StaticResource ValueText}" />

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="手部偏移 Y" Style="{StaticResource FieldLabelText}" />
                                        <Slider x:Name="SldHandY" Grid.Row="1" Grid.Column="1" Minimum="-0.35" Maximum="0.35" SmallChange="0.01" LargeChange="0.05" ValueChanged="OnPlacementSliderChanged" />
                                        <TextBlock x:Name="LblHandY" Grid.Row="1" Grid.Column="2" Text="+0.10 m" Style="{StaticResource ValueText}" />

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="手部偏移 Z" Style="{StaticResource FieldLabelText}" />
                                        <Slider x:Name="SldHandZ" Grid.Row="2" Grid.Column="1" Minimum="-0.35" Maximum="0.35" SmallChange="0.01" LargeChange="0.05" ValueChanged="OnPlacementSliderChanged" />
                                        <TextBlock x:Name="LblHandZ" Grid.Row="2" Grid.Column="2" Text="-0.05 m" Style="{StaticResource ValueText}" />
                                    </Grid>

                                    <Grid Grid.Column="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="74" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="42" />
                                            <RowDefinition Height="42" />
                                            <RowDefinition Height="42" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="俯仰角 Pitch" Style="{StaticResource FieldLabelText}" />
                                        <Slider x:Name="SldHandPitch" Grid.Row="0" Grid.Column="1" Minimum="-90" Maximum="90" SmallChange="2" LargeChange="15" ValueChanged="OnPlacementSliderChanged" />
                                        <TextBlock x:Name="LblHandPitch" Grid.Row="0" Grid.Column="2" Text="-45.0°" Style="{StaticResource ValueText}" />

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="偏航角 Yaw" Style="{StaticResource FieldLabelText}" />
                                        <Slider x:Name="SldHandYaw" Grid.Row="1" Grid.Column="1" Minimum="-180" Maximum="180" SmallChange="5" LargeChange="15" ValueChanged="OnPlacementSliderChanged" />
                                        <TextBlock x:Name="LblHandYaw" Grid.Row="1" Grid.Column="2" Text="0.0°" Style="{StaticResource ValueText}" />

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="翻滚角 Roll" Style="{StaticResource FieldLabelText}" />
                                        <Slider x:Name="SldHandRoll" Grid.Row="2" Grid.Column="1" Minimum="-180" Maximum="180" SmallChange="5" LargeChange="15" ValueChanged="OnPlacementSliderChanged" />
                                        <TextBlock x:Name="LblHandRoll" Grid.Row="2" Grid.Column="2" Text="0.0°" Style="{StaticResource ValueText}" />
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ==================== PAGE 2: 字体与排版布局 ==================== -->
                    <StackPanel x:Name="PageTypography" Visibility="Collapsed">
                        <StackPanel Margin="2,0,2,20">
                            <TextBlock Text="字体与排版布局" Style="{StaticResource PageTitleText}" />
