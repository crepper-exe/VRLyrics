<Window x:Class="VRLyrics.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VRLyrics · SteamVR 实时歌词控制中心"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="1120"
        Height="840"
        MinWidth="960"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="#0B0F19"
        Foreground="#F1F5F9"
        FontFamily="Microsoft YaHei UI">

    <Window.Resources>
        <SolidColorBrush x:Key="CardBgBrush" Color="#131B2E" />
        <SolidColorBrush x:Key="CardBorderBrush" Color="#22304A" />
        <SolidColorBrush x:Key="SubCardBgBrush" Color="#0E1525" />
        <SolidColorBrush x:Key="AccentBrush" Color="#38BDF8" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F1F5F9" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#94A3B8" />
        <SolidColorBrush x:Key="InputBgBrush" Color="#0A101D" />

        <!-- WinUI 3 Fluent Action Button -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="Foreground" Value="#F1F5F9" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#27364F" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#38BDF8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#162032" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#0284C7" />
            <Setter Property="BorderBrush" Value="#38BDF8" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#3B1824" />
            <Setter Property="BorderBrush" Value="#7F1D3A" />
            <Setter Property="Foreground" Value="#FDA4AF" />
        </Style>

        <Style x:Key="DarkTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#0A101D" />
            <Setter Property="Foreground" Value="#F1F5F9" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="CaretBrush" Value="#38BDF8" />
        </Style>

        <!-- WinUI 3 Fluent Pill ToggleSwitch (replaces legacy square CheckBox) -->
        <Style x:Key="FluentToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#F1F5F9" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center" Margin="0,0,10,0" RecognizesAccessKey="True" />
                            <Border x:Name="SwitchTrack"
                                    Width="42"
                                    Height="22"
                                    CornerRadius="11"
                                    Background="#1E293B"
                                    BorderBrush="#64748B"
                                    BorderThickness="1.5">
                                <Ellipse x:Name="SwitchThumb"
                                         Width="14"
                                         Height="14"
                                         Fill="#CBD5E1"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Center"
                                         Margin="3,0,0,0" />
                            </Border>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="#94A3B8" />
                                <Setter TargetName="SwitchThumb" Property="Fill" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Background" Value="#0284C7" />
                                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="#38BDF8" />
                                <Setter TargetName="SwitchThumb" Property="Fill" Value="#FFFFFF" />
                                <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="SwitchThumb" Property="Margin" Value="0,0,3,0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox" BasedOn="{StaticResource FluentToggleSwitchStyle}" />

        <!-- WinUI 3 NavigationView Sidebar Item -->
        <Style x:Key="NavItemRadioStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="NavBd"
                                Background="Transparent"
                                CornerRadius="8"
                                Padding="12,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="IndicatorBar"
                                        Width="3.5"
                                        Height="18"
                                        CornerRadius="2"
                                        Background="Transparent"
                                        VerticalAlignment="Center"
                                        Margin="0,0,10,0" />
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBd" Property="Background" Value="#162033" />
                                <Setter Property="Foreground" Value="#E2E8F0" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="NavBd" Property="Background" Value="#1A2740" />
                                <Setter TargetName="IndicatorBar" Property="Background" Value="#38BDF8" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- WinUI 3 Segmented Pill Selector -->
        <Style x:Key="SegmentedItemRadioStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="SegBd"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="12,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SegBd" Property="Background" Value="#182338" />
                                <Setter Property="Foreground" Value="#F1F5F9" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SegBd" Property="Background" Value="#0369A1" />
                                <Setter TargetName="SegBd" Property="BorderBrush" Value="#38BDF8" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- WinUI 3 SettingsCard Container -->
        <Style x:Key="SettingsCardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBgBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="18,14" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <!-- ==================== ROOT WINUI 3 NAVIGATION LAYOUT ==================== -->
    <Grid Background="#0B0F19">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ==================== LEFT SIDEBAR (NavigationView Pane) ==================== -->
        <Border Grid.Column="0"
                Background="#0E1422"
                BorderBrush="#1E293B"
                BorderThickness="0,0,1,0"
                Padding="14,16,14,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 1. Brand Header -->
                <StackPanel Grid.Row="0" Margin="4,0,4,14">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/Assets/logo.png"
                               Height="32"
                               Margin="0,0,10,0"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="VRLyrics" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC" />
                            <TextBlock Text="Fluent Control Hub" FontSize="11" Foreground="#64748B" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- 2. Live VR & Player Status Pills -->
                <Border Grid.Row="1"
                        Background="#131C2E"
                        BorderBrush="#22304A"
                        BorderThickness="1"
                        CornerRadius="9"
                        Padding="10,9"
                        Margin="0,0,0,14">
                    <StackPanel>
                        <Border x:Name="VrStatusBadge"
                                Background="#162936"
                                BorderBrush="#0284C7"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8,4"
                                Margin="0,0,0,6">
                            <TextBlock x:Name="VrStatusText"
                                       Text="○ 等待 SteamVR…"
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       Foreground="#7DD3FC"
                                       TextTrimming="CharacterEllipsis" />
                        </Border>

                        <TextBlock x:Name="PlayerStatusText"
                                   Text="播放器：未检测"
                                   FontSize="11.5"
                                   Foreground="#CBD5E1"
                                   Margin="2,0,0,3"
                                   TextTrimming="CharacterEllipsis" />

                        <TextBlock x:Name="TrackAndLyricsStatusText"
                                   Text="正在等待播放曲目…"
                                   FontSize="11"
                                   Foreground="#94A3B8"
                                   Margin="2,0,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- 3. Navigation Menu Items -->
                <StackPanel Grid.Row="2">
                    <TextBlock Text="设置分类" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="10,0,0,6" />
                    <RadioButton x:Name="NavPlacement"
                                 Style="{StaticResource NavItemRadioStyle}"
                                 GroupName="MainNav"
                                 Content="📍  显示与空间锚定"
                                 IsChecked="True"
                                 Checked="OnNavPageRadioChecked" />
                    <RadioButton x:Name="NavTypography"
                                 Style="{StaticResource NavItemRadioStyle}"
                                 GroupName="MainNav"
                                 Content="🔤  字体与排版布局"
                                 Checked="OnNavPageRadioChecked" />
                    <RadioButton x:Name="NavColors"
                                 Style="{StaticResource NavItemRadioStyle}"
                                 GroupName="MainNav"
                                 Content="🎨  色彩主题与动效"
                                 Checked="OnNavPageRadioChecked" />
                    <RadioButton x:Name="NavSystem"
                                 Style="{StaticResource NavItemRadioStyle}"
                                 GroupName="MainNav"
                                 Content="⏱️  时间轴与系统集成"
                                 Checked="OnNavPageRadioChecked" />
                </StackPanel>

                <!-- 4. Sidebar Footer Quick Toggles & Window Actions -->
                <Border Grid.Row="3"
                        Background="#131C2E"
                        BorderBrush="#22304A"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="12,10">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="显示 VR 歌词" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <CheckBox x:Name="ChkOverlayEnabled"
                                      HorizontalAlignment="Right"
                                      Checked="OnOverlayEnabledChanged"
                                      Unchecked="OnOverlayEnabledChanged" />
                        </DockPanel>

                        <DockPanel Margin="0,0,0,10">
                            <TextBlock Text="🎬 样式演示动画"
                                       FontSize="12.5"
                                       VerticalAlignment="Center"
                                       ToolTip="开启后在预览区和VR中循环播放逐字卡拉OK演示歌词" />
                            <CheckBox x:Name="ChkDemoLoop"
                                      HorizontalAlignment="Right"
                                      Checked="OnDemoLoopChanged"
                                      Unchecked="OnDemoLoopChanged" />
                        </DockPanel>

                        <Button Content="🔄 重新获取当前歌词"
                                Style="{StaticResource ActionButtonStyle}"
                                Margin="0,0,0,6"
                                Click="OnReloadLyricsClick" />

                        <UniformGrid Columns="2">
                            <Button Content="最小化托盘"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Margin="0,0,4,0"
                                    Padding="8,6"
                                    Click="OnMinimizeToTrayClick" />
                            <Button Content="彻底退出"
                                    Style="{StaticResource DangerButtonStyle}"
                                    Margin="4,0,0,0"
                                    Padding="8,6"
                                    Click="OnExitAppClick" />
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ==================== RIGHT MAIN CONTENT AREA ==================== -->
        <Grid Grid.Column="1" Margin="20,16,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 1. Pinned Live 1:1 VR Overlay Preview Card (Collapsible) -->
            <Border Grid.Row="0"
                    Background="#0E1525"
                    BorderBrush="#22304A"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14,10"
                    Margin="0,0,0,14">
                <StackPanel>
                    <DockPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🥽 实时叠加层渲染预览（与 VR 头显内 1:1 同步）"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#38BDF8"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="PreviewMetaText"
                                       Text="1600×420 · 60 FPS · 修改设置即时生效"
                                       FontSize="11.5"
                                       Foreground="#64748B"
                                       VerticalAlignment="Center"
                                       Margin="12,0,0,0" />
                        </StackPanel>

                        <Button x:Name="BtnTogglePreviewCollapse"
                                Content="收起预览 ▲"
                                Style="{StaticResource ActionButtonStyle}"
                                HorizontalAlignment="Right"
                                Padding="10,3"
                                FontSize="11.5"
                                Click="OnTogglePreviewCollapseClick" />
                    </DockPanel>

                    <Border x:Name="PreviewCanvasContainer"
                            Height="164"
                            Margin="0,8,0,0"
                            CornerRadius="8"
                            BorderBrush="#1E293B"
                            BorderThickness="1"
                            ClipToBounds="True">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#111A2E" Offset="0" />
                                <GradientStop Color="#080C16" Offset="0.55" />
                                <GradientStop Color="#142238" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Image x:Name="PreviewImage"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- 2. Scrollable Fluent Settings Pages -->
            <ScrollViewer x:Name="MainPageScrollViewer"
                          Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          Padding="0,0,6,0">
                <Grid>
                    <!-- ==================== PAGE 1: 显示与空间锚定 ==================== -->
                    <StackPanel x:Name="PagePlacement" Visibility="Visible">
                        <DockPanel Margin="2,0,2,10">
                            <StackPanel>
                                <TextBlock Text="显示与空间锚定" FontSize="20" FontWeight="Bold" Foreground="#F8FAFC" />
                                <TextBlock Text="选择歌词在 VR 中的锚定方式，并调节物理尺寸、环绕曲面与空间坐标" FontSize="12.5" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                            <Button Content="↺ 恢复当前位置默认参数"
                                    Style="{StaticResource ActionButtonStyle}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Click="OnResetPlacementClick" />
                        </DockPanel>

                        <!-- Mode Segmented Selector Card -->
                        <Border Style="{StaticResource SettingsCardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="空间挂载模式" FontSize="13.5" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <Border Background="{StaticResource SubCardBgBrush}"
                                        BorderBrush="#1E293B"
                                        BorderThickness="1"
                                        CornerRadius="9"
                                        Padding="3">
                                    <UniformGrid Columns="4">
                                        <RadioButton x:Name="RbModeHead" Style="{StaticResource SegmentedItemRadioStyle}" GroupName="AttachMode" Content="👀 头部跟随 (视野下方)" Checked="OnAttachmentModeRadioChecked" />
                                        <RadioButton x:Name="RbModeWorld" Style="{StaticResource SegmentedItemRadioStyle}" GroupName="AttachMode" Content="🌍 空间固定 (可手柄拖拽)" Checked="OnAttachmentModeRadioChecked" />
                                        <RadioButton x:Name="RbModeLeftHand" Style="{StaticResource SegmentedItemRadioStyle}" GroupName="AttachMode" Content="⌚ 左手腕跟随" Checked="OnAttachmentModeRadioChecked" />
                                        <RadioButton x:Name="RbModeRightHand" Style="{StaticResource SegmentedItemRadioStyle}" GroupName="AttachMode" Content="⌚ 右手腕跟随" Checked="OnAttachmentModeRadioChecked" />
                                    </UniformGrid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Physical Dimensions Card -->
                        <Border Style="{StaticResource SettingsCardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="物理尺寸、不透明度与曲面弧度" FontSize="13.5" FontWeight="SemiBold" Foreground="#38BDF8" Margin="0,0,0,10" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="34" />
                                        <RowDefinition Height="34" />
                                        <RowDefinition Height="34" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="画面物理宽度 (米)" VerticalAlignment="Center" />
                                    <Slider x:Name="SldWidthMeters" Grid.Row="0" Grid.Column="1" Minimum="0.25" Maximum="2.40" SmallChange="0.05" LargeChange="0.2" ValueChanged="OnPlacementSliderChanged" />
                                    <TextBlock x:Name="LblWidthMeters" Grid.Row="0" Grid.Column="2" Text="0.95 m" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#7DD3FC" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="画面整体不透明度" VerticalAlignment="Center" />
                                    <Slider x:Name="SldOpacity" Grid.Row="1" Grid.Column="1" Minimum="0.15" Maximum="1.00" SmallChange="0.05" LargeChange="0.1" ValueChanged="OnPlacementSliderChanged" />
                                    <TextBlock x:Name="LblOpacity" Grid.Row="1" Grid.Column="2" Text="96%" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#7DD3FC" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="画面曲面环绕度 (Curvature)" VerticalAlignment="Center" />
                                    <Slider x:Name="SldCurvature" Grid.Row="2" Grid.Column="1" Minimum="0.00" Maximum="0.40" SmallChange="0.02" LargeChange="0.05" ValueChanged="OnPlacementSliderChanged" />
                                    <TextBlock x:Name="LblCurvature" Grid.Row="2" Grid.Column="2" Text="8%" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#7DD3FC" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Mode Panel A: HeadLocked -->
                        <Border x:Name="PanelHeadMode" Style="{StaticResource SettingsCardBorderStyle}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <TextBlock Text="👀 头部跟随偏移与倾角" FontSize="13.5" FontWeight="SemiBold" Foreground="#38BDF8" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="视野正下方(默认)" Style="{StaticResource ActionButtonStyle}" Padding="10,4" Margin="0,0,6,0" Tag="BottomCenter" Click="OnHeadPresetClick" />
                                        <Button Content="视野正上方" Style="{StaticResource ActionButtonStyle}" Padding="10,4" Margin="0,0,6,0" Tag="Top" Click="OnHeadPresetClick" />
                                        <Button Content="视野左下角" Style="{StaticResource ActionButtonStyle}" Padding="10,4" Margin="0,0,6,0" Tag="BottomLeft" Click="OnHeadPresetClick" />
                                        <Button Content="视野右下角" Style="{StaticResource ActionButtonStyle}" Padding="10,4" Tag="BottomRight" Click="OnHeadPresetClick" />
                                    </StackPanel>
                                </DockPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="32" />
                                        <RowDefinition Height="32" />
                                        <RowDefinition Height="32" />
                                        <RowDefinition Height="32" />
                                        <RowDefinition Height="32" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="水平偏移 X (左/右)" VerticalAlignment="Center" />
                                    <Slider x:Name="SldHeadX" Grid.Row="0" Grid.Column="1" Minimum="-0.80" Maximum="0.80" SmallChange="0.02" LargeChange="0.1" ValueChanged="OnPlacementSliderChanged" />
                                    <TextBlock x:Name="LblHeadX" Grid.Row="0" Grid.Column="2" Text="+0.00 m" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#7DD3FC" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="垂直偏移 Y (下/上)" VerticalAlignment="Center" />
                                    <Slider x:Name="SldHeadY" Grid.Row="1" Grid.Column="1" Minimum="-0.75" Maximum="0.75" SmallChange="0.02" LargeChange="0.1" ValueChanged="OnPlacementSliderChanged" />
                                    <TextBlock x:Name="LblHeadY" Grid.Row="1" Grid.Column="2" Text="-0.24 m" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#7DD3FC" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="前后距离 Z (越负越远)" VerticalAlignment="Center" />
                                    <Slider x:Name="SldHeadZ" Grid.Row="2" Grid.Column="1" Minimum="-2.80" Maximum="-0.45" SmallChange="0.05" LargeChange="0.2" ValueChanged="OnPlacementSliderChanged" />
                                    <TextBlock x:Name="LblHeadZ" Grid.Row="2" Grid.Column="2" Text="-1.15 m" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#7DD3FC" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="俯仰倾角 Pitch (°)" VerticalAlignment="Center" />
                                    <Slider x:Name="SldHeadPitch" Grid.Row="3" Grid.Column="1" Minimum="-45" Maximum="45" SmallChange="1" LargeChange="5" ValueChanged="OnPlacementSliderChanged" />
                                    <TextBlock x:Name="LblHeadPitch" Grid.Row="3" Grid.Column="2" Text="+12.0°" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#7DD3FC" />

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="水平偏航角 Yaw (°)" VerticalAlignment="Center" />
                                    <Slider x:Name="SldHeadYaw" Grid.Row="4" Grid.Column="1" Minimum="-45" Maximum="45" SmallChange="1" LargeChange="5" ValueChanged="OnPlacementSliderChanged" />
                                    <TextBlock x:Name="LblHeadYaw" Grid.Row="4" Grid.Column="2" Text="0.0°" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#7DD3FC" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Mode Panel B: WorldLocked -->
                        <Border x:Name="PanelWorldMode" Style="{StaticResource SettingsCardBorderStyle}" Visibility="Collapsed">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="🌍 空间固定坐标与 VR 手柄交互" FontSize="13.5" FontWeight="SemiBold" Foreground="#38BDF8" />
                                        <TextBlock Text="在 VR 中用手柄指向歌词按住 Grip(侧键)/Trigger(扳机) 即可自由拖动位置，推摇杆调节远近" FontSize="11.5" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Button Content="📍 移至当前头显视野正前方"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Click="OnRecenterWorldToHmdClick" />
                                </DockPanel>

                                <WrapPanel Margin="0,0,0,10">
                                    <CheckBox x:Name="ChkWorldControllerGrab"
                                              Content="✋ 允许使用 VR 手柄抓取拖动歌词"
                                              Margin="0,0,28,4"
                                              Checked="OnWorldGrabCheckChanged"
                                              Unchecked="OnWorldGrabCheckChanged" />
                                    <CheckBox x:Name="ChkWorldAutoFaceHmd"
                                              Content="🧭 拖动时自动使歌词正面朝向头显"
                                              Margin="0,0,0,4"
                                              Checked="OnWorldGrabCheckChanged"
                                              Unchecked="OnWorldGrabCheckChanged" />
                                </WrapPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="32" />
                                        <RowDefinition Height="32" />
                                        <RowDefinition Height="32" />
                                        <RowDefinition Height="32" />
                                        <RowDefinition Height="32" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="世界坐标 X (左右)" VerticalAlignment="Center" />
                                    <Slider x:Name="SldWorldX" Grid.Row="0" Grid.Column="1" Minimum="-3.00" Maximum="3.00" SmallChange="0.05" LargeChange="0.2" ValueChanged="OnPlacementSliderChanged" />
                                    <TextBlock x:Name="LblWorldX" Grid.Row="0" Grid.Column="2" Text="+0.00 m" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#7DD3FC" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="世界坐标 Y (高度)" VerticalAlignment="Center" />
                                    <Slider x:Name="SldWorldY" Grid.Row="1" Grid.Column="1" Minimum="0.20" Maximum="2.80" SmallChange="0.05" LargeChange="0.2" ValueChanged="OnPlacementSliderChanged" />
                                    <TextBlock x:Name="LblWorldY" Grid.Row="1" Grid.Column="2" Text="1.30 m" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#7DD3FC" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="世界坐标 Z (前后)" VerticalAlignment="Center" />
                                    <Slider x:Name="SldWorldZ" Grid.Row="2" Grid.Column="1" Minimum="-3.50" Maximum="3.50" SmallChange="0.05" LargeChange="0.2" ValueChanged="OnPlacementSliderChanged" />
                                    <TextBlock x:Name="LblWorldZ" Grid.Row="2" Grid.Column="2" Text="-1.40 m" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#7DD3FC" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="水平朝向角 Yaw (°)" VerticalAlignment="Center" />
                                    <Slider x:Name="SldWorldYaw" Grid.Row="3" Grid.Column="1" Minimum="-180" Maximum="180" SmallChange="2" LargeChange="15" ValueChanged="OnPlacementSliderChanged" />
                                    <TextBlock x:Name="LblWorldYaw" Grid.Row="3" Grid.Column="2" Text="0.0°" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#7DD3FC" />

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="俯仰倾角 Pitch (°)" VerticalAlignment="Center" />
                                    <Slider x:Name="SldWorldPitch" Grid.Row="4" Grid.Column="1" Minimum="-60" Maximum="60" SmallChange="1" LargeChange="10" ValueChanged="OnPlacementSliderChanged" />
                                    <TextBlock x:Name="LblWorldPitch" Grid.Row="4" Grid.Column="2" Text="0.0°" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#7DD3FC" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Mode Panel C: LeftHand / RightHand -->
                        <Border x:Name="PanelHandMode" Style="{StaticResource SettingsCardBorderStyle}" Visibility="Collapsed">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <TextBlock x:Name="LblHandModeTitle" Text="⌚ 手腕 / 手柄跟随位置与角度" FontSize="13.5" FontWeight="SemiBold" Foreground="#38BDF8" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="手柄正上方(默认)" Style="{StaticResource ActionButtonStyle}" Padding="10,4" Margin="0,0,6,0" Tag="AboveController" Click="OnHandPresetClick" />
                                        <Button Content="⌚ 手腕内侧(看表姿势)" Style="{StaticResource ActionButtonStyle}" Padding="10,4" Margin="0,0,6,0" Tag="InnerWrist" Click="OnHandPresetClick" />
                                        <Button Content="🤚 手背外侧" Style="{StaticResource ActionButtonStyle}" Padding="10,4" Tag="OuterWrist" Click="OnHandPresetClick" />
                                    </StackPanel>
                                </DockPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="32" />
                                        <RowDefinition Height="32" />
                                        <RowDefinition Height="32" />
                                        <RowDefinition Height="32" />
                                        <RowDefinition Height="32" />
                                        <RowDefinition Height="32" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="手部偏移 X (左右)" VerticalAlignment="Center" />
                                    <Slider x:Name="SldHandX" Grid.Row="0" Grid.Column="1" Minimum="-0.35" Maximum="0.35" SmallChange="0.01" LargeChange="0.05" ValueChanged="OnPlacementSliderChanged" />
                                    <TextBlock x:Name="LblHandX" Grid.Row="0" Grid.Column="2" Text="+0.00 m" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#7DD3FC" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="手部偏移 Y (上下)" VerticalAlignment="Center" />
                                    <Slider x:Name="SldHandY" Grid.Row="1" Grid.Column="1" Minimum="-0.35" Maximum="0.35" SmallChange="0.01" LargeChange="0.05" ValueChanged="OnPlacementSliderChanged" />
                                    <TextBlock x:Name="LblHandY" Grid.Row="1" Grid.Column="2" Text="+0.10 m" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#7DD3FC" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="手部偏移 Z (前后)" VerticalAlignment="Center" />
                                    <Slider x:Name="SldHandZ" Grid.Row="2" Grid.Column="1" Minimum="-0.35" Maximum="0.35" SmallChange="0.01" LargeChange="0.05" ValueChanged="OnPlacementSliderChanged" />
                                    <TextBlock x:Name="LblHandZ" Grid.Row="2" Grid.Column="2" Text="-0.05 m" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#7DD3FC" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="手腕俯仰角 Pitch (°)" VerticalAlignment="Center" />
                                    <Slider x:Name="SldHandPitch" Grid.Row="3" Grid.Column="1" Minimum="-90" Maximum="90" SmallChange="2" LargeChange="15" ValueChanged="OnPlacementSliderChanged" />
                                    <TextBlock x:Name="LblHandPitch" Grid.Row="3" Grid.Column="2" Text="-45.0°" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#7DD3FC" />

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="手腕偏航角 Yaw (°)" VerticalAlignment="Center" />
                                    <Slider x:Name="SldHandYaw" Grid.Row="4" Grid.Column="1" Minimum="-180" Maximum="180" SmallChange="5" LargeChange="15" ValueChanged="OnPlacementSliderChanged" />
                                    <TextBlock x:Name="LblHandYaw" Grid.Row="4" Grid.Column="2" Text="0.0°" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#7DD3FC" />

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="手腕翻滚角 Roll (°)" VerticalAlignment="Center" />
                                    <Slider x:Name="SldHandRoll" Grid.Row="5" Grid.Column="1" Minimum="-180" Maximum="180" SmallChange="5" LargeChange="15" ValueChanged="OnPlacementSliderChanged" />
                                    <TextBlock x:Name="LblHandRoll" Grid.Row="5" Grid.Column="2" Text="0.0°" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#7DD3FC" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ==================== PAGE 2: 字体与排版布局 ==================== -->
                    <StackPanel x:Name="PageTypography" Visibility="Collapsed">
                        <StackPanel Margin="2,0,2,10">
                            <TextBlock Text="字体与排版布局" FontSize="20" FontWeight="Bold" Foreground="#F8FAFC" />
                            <TextBlock Text="自定义歌词字体族、三级字号比例以及双语翻译与上下文行展示开关" FontSize="12.5" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,0" />
                        </StackPanel>

                        <Border Style="{StaticResource SettingsCardBorderStyle}">
                            <DockPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="歌词显示字体" FontSize="13.5" FontWeight="SemiBold" />
                                    <TextBlock Text="可从本机已安装字体中选择或直接输入字体名称" FontSize="11.5" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,0" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <ComboBox x:Name="CmbFontFamily"
                                              Width="250"
                                              Height="32"
                                              IsEditable="True"
                                              VerticalContentAlignment="Center"
                                              Margin="0,0,20,0"
                                              SelectionChanged="OnFontFamilySelectionChanged"
                                              LostFocus="OnFontFamilyLostFocus" />
                                    <CheckBox x:Name="ChkBold"
                                              Content="粗体字重 (Bold)"
                                              Checked="OnTypographyCheckChanged"
                                              Unchecked="OnTypographyCheckChanged" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="三级字号比例调节" FontSize="13.5" FontWeight="SemiBold" Foreground="#38BDF8" Margin="0,0,0,10" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="36" />
                                        <RowDefinition Height="36" />
                                        <RowDefinition Height="36" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="当前主歌词字号" VerticalAlignment="Center" />
                                    <Slider x:Name="SldMainFontSize" Grid.Row="0" Grid.Column="1" Minimum="28" Maximum="84" SmallChange="1" LargeChange="4" ValueChanged="OnTypographySliderChanged" />
                                    <TextBlock x:Name="LblMainFontSize" Grid.Row="0" Grid.Column="2" Text="52 px" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#7DD3FC" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="双语翻译行字号" VerticalAlignment="Center" />
                                    <Slider x:Name="SldTransFontSize" Grid.Row="1" Grid.Column="1" Minimum="18" Maximum="56" SmallChange="1" LargeChange="4" ValueChanged="OnTypographySliderChanged" />
                                    <TextBlock x:Name="LblTransFontSize" Grid.Row="1" Grid.Column="2" Text="30 px" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#7DD3FC" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="上下句预览字号" VerticalAlignment="Center" />
                                    <Slider x:Name="SldContextFontSize" Grid.Row="2" Grid.Column="1" Minimum="18" Maximum="56" SmallChange="1" LargeChange="4" ValueChanged="OnTypographySliderChanged" />
                                    <TextBlock x:Name="LblContextFontSize" Grid.Row="2" Grid.Column="2" Text="32 px" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#7DD3FC" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCardBorderStyle}">
                            <DockPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="显示双语翻译行" FontSize="13.5" FontWeight="SemiBold" />
                                    <TextBlock Text="当外语歌曲包含中文翻译时，在主歌词正下方同步渲染译文" FontSize="11.5" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                                <CheckBox x:Name="ChkShowTranslation" HorizontalAlignment="Right" Checked="OnTypographyCheckChanged" Unchecked="OnTypographyCheckChanged" />
                            </DockPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCardBorderStyle}">
                            <DockPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="显示上一句 / 下一句上下文歌词" FontSize="13.5" FontWeight="SemiBold" />
                                    <TextBlock Text="在主歌词上下方半透明预览相邻歌词行，提前预知下一句唱词" FontSize="11.5" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                                <CheckBox x:Name="ChkShowContextLines" HorizontalAlignment="Right" Checked="OnTypographyCheckChanged" Unchecked="OnTypographyCheckChanged" />
                            </DockPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCardBorderStyle}">
                            <DockPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="显示顶部歌曲名与播放时间进度条" FontSize="13.5" FontWeight="SemiBold" />
                                    <TextBlock Text="在叠加层顶部展示当前歌名、歌手及播放时间" FontSize="11.5" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                                <CheckBox x:Name="ChkShowTrackHeader" HorizontalAlignment="Right" Checked="OnTypographyCheckChanged" Unchecked="OnTypographyCheckChanged" />
                            </DockPanel>
                        </Border>
                    </StackPanel>

                    <!-- ==================== PAGE 3: 色彩主题与动效 ==================== -->
                    <StackPanel x:Name="PageColors" Visibility="Collapsed">
                        <StackPanel Margin="2,0,2,10">
                            <TextBlock Text="色彩主题与动效" FontSize="20" FontWeight="Bold" Foreground="#F8FAFC" />
                            <TextBlock Text="一键切换精选卡拉OK配色方案，或点击色块通过现代调色器精细定制每一处光效" FontSize="12.5" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,0" />
                        </StackPanel>

                        <Border Style="{StaticResource SettingsCardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="一键精选配色主题" FontSize="13.5" FontWeight="SemiBold" Foreground="#38BDF8" Margin="0,0,0,10" />
                                <WrapPanel x:Name="PresetButtonsPanel" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="卡拉OK动效与描边阴影参数" FontSize="13.5" FontWeight="SemiBold" Foreground="#38BDF8" Margin="0,0,0,10" />
                                <WrapPanel Margin="0,0,0,12">
                                    <CheckBox x:Name="ChkKaraokeHighlight" Content="🎤 逐字渐变擦除高亮" Margin="0,0,26,6" Checked="OnAnimationCheckChanged" Unchecked="OnAnimationCheckChanged" />
                                    <CheckBox x:Name="ChkWordLift" Content="🎵 正在演唱单字微抬律动" Margin="0,0,26,6" Checked="OnAnimationCheckChanged" Unchecked="OnAnimationCheckChanged" />
                                    <CheckBox x:Name="ChkLineTransition" Content="🌊 切行平滑上滑缩放动画" Margin="0,0,0,6" Checked="OnAnimationCheckChanged" Unchecked="OnAnimationCheckChanged" />
                                </WrapPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="34" />
                                        <RowDefinition Height="34" />
                                        <RowDefinition Height="34" />
                                        <RowDefinition Height="34" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="切行过渡动画时长" VerticalAlignment="Center" />
