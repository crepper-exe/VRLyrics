<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
        VRLyrics desktop theme · low-saturation dark
        Neutrals carry a faint cool cast; a single dusty-blue accent marks state (selected / on / filled).
        Hierarchy comes from weight, size and spacing rather than colour.
    -->

    <!-- ===== Typography ===== -->
    <!-- Latin glyphs render in Google Sans (bundled, OFL); CJK falls back to Microsoft YaHei UI. -->
    <FontFamily x:Key="UiFont">pack://application:,,,/Assets/Fonts/#Google Sans 18pt, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

    <sys:Double x:Key="FontSizeTitle">24</sys:Double>
    <sys:Double x:Key="FontSizeCardTitle">15</sys:Double>
    <sys:Double x:Key="FontSizeBody">13.5</sys:Double>
    <sys:Double x:Key="FontSizeCaption">12.5</sys:Double>
    <sys:Double x:Key="FontSizeSmall">11.5</sys:Double>

    <!-- ===== Colour tokens ===== -->
    <Color x:Key="ColorBg">#141619</Color>
    <Color x:Key="ColorSidebar">#17191D</Color>
    <Color x:Key="ColorCard">#1C1F24</Color>
    <Color x:Key="ColorInset">#15171B</Color>
    <Color x:Key="ColorBorder">#292D34</Color>
    <Color x:Key="ColorBorderStrong">#383D46</Color>
    <Color x:Key="ColorHover">#24282E</Color>
    <Color x:Key="ColorPressed">#1A1D21</Color>
    <Color x:Key="ColorSelected">#272B32</Color>

    <Color x:Key="ColorText1">#E4E6EA</Color>
    <Color x:Key="ColorText2">#A6ACB6</Color>
    <Color x:Key="ColorText3">#878E99</Color>
    <Color x:Key="ColorValue">#BCC6D3</Color>

    <Color x:Key="ColorAccent">#8EA3BF</Color>
    <Color x:Key="ColorAccentHover">#9DB1CB</Color>
    <Color x:Key="ColorAccentSoft">#2C333D</Color>
    <Color x:Key="ColorAccentSoftBorder">#3D4756</Color>
    <Color x:Key="ColorOnAccent">#13161A</Color>

    <Color x:Key="ColorTrack">#353A42</Color>
    <Color x:Key="ColorThumb">#D6DBE2</Color>

    <Color x:Key="ColorSuccess">#8DB39A</Color>
    <Color x:Key="ColorSuccessText">#B4CBBB</Color>
    <Color x:Key="ColorSuccessSoft">#1D2621</Color>
    <Color x:Key="ColorWarning">#C6AD7E</Color>
    <Color x:Key="ColorWarningText">#D5C6A5</Color>
    <Color x:Key="ColorWarningSoft">#26231C</Color>

    <Color x:Key="ColorDanger">#D3A0A0</Color>
    <Color x:Key="ColorDangerSoft">#272022</Color>
    <Color x:Key="ColorDangerBorder">#443134</Color>
    <Color x:Key="ColorDangerHover">#30262A</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource ColorBg}" />
    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource ColorSidebar}" />
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource ColorCard}" />
    <SolidColorBrush x:Key="InsetBrush" Color="{StaticResource ColorInset}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource ColorBorder}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource ColorBorderStrong}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource ColorHover}" />
    <SolidColorBrush x:Key="PressedBrush" Color="{StaticResource ColorPressed}" />
    <SolidColorBrush x:Key="SelectedBrush" Color="{StaticResource ColorSelected}" />
    <SolidColorBrush x:Key="Text1Brush" Color="{StaticResource ColorText1}" />
    <SolidColorBrush x:Key="Text2Brush" Color="{StaticResource ColorText2}" />
    <SolidColorBrush x:Key="Text3Brush" Color="{StaticResource ColorText3}" />
    <SolidColorBrush x:Key="ValueBrush" Color="{StaticResource ColorValue}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource ColorAccent}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource ColorAccentHover}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource ColorAccentSoft}" />
    <SolidColorBrush x:Key="AccentSoftBorderBrush" Color="{StaticResource ColorAccentSoftBorder}" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource ColorOnAccent}" />
    <SolidColorBrush x:Key="TrackBrush" Color="{StaticResource ColorTrack}" />
    <SolidColorBrush x:Key="ThumbBrush" Color="{StaticResource ColorThumb}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource ColorDanger}" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="{StaticResource ColorDangerSoft}" />
    <SolidColorBrush x:Key="DangerBorderBrush" Color="{StaticResource ColorDangerBorder}" />
    <SolidColorBrush x:Key="DangerHoverBrush" Color="{StaticResource ColorDangerHover}" />

    <!-- ===== Text styles ===== -->
    <Style x:Key="PageTitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Text1Brush}" />
    </Style>
    <Style x:Key="PageDescText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{StaticResource Text2Brush}" />
        <Setter Property="Margin" Value="0,6,0,0" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="21" />
    </Style>
    <Style x:Key="CardTitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeCardTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Text1Brush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="CardDescText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="Foreground" Value="{StaticResource Text3Brush}" />
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="19" />
    </Style>
    <Style x:Key="FieldLabelText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{StaticResource Text2Brush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="ValueText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource ValueBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>

    <!-- ===== Buttons ===== -->
    <Style x:Key="ActionButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource HoverBrush}" />
        <Setter Property="Foreground" Value="{StaticResource Text1Brush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#2B3037" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#454B55" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentHoverBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#7F94B0" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
        <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource DangerBorderBrush}" />
        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource DangerHoverBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#5A3E42" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource DangerSoftBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Quiet text button (no fill until hover) -->
    <Style x:Key="GhostButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Text2Brush}" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="FontSize" Value="12.5" />
    </Style>

    <!-- Colour swatch button -->
    <Style x:Key="SwatchButtonStyle" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Frame"
                            CornerRadius="7"
                            BorderThickness="1"
                            BorderBrush="{StaticResource BorderStrongBrush}"
                            Padding="2">
                        <Border.Background>
                            <!-- checkerboard so translucent colours read as translucent -->
                            <DrawingBrush TileMode="Tile" Viewport="0,0,8,8" ViewportUnits="Absolute">
                                <DrawingBrush.Drawing>
                                    <DrawingGroup>
                                        <GeometryDrawing Brush="#2A2D33" Geometry="M0,0 H2 V2 H0Z" />
                                        <GeometryDrawing Brush="#3A3E45" Geometry="M0,0 H1 V1 H0Z M1,1 H2 V2 H1Z" />
                                    </DrawingGroup>
                                </DrawingBrush.Drawing>
                            </DrawingBrush>
                        </Border.Background>
                        <Border CornerRadius="5" Background="{TemplateBinding Background}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Inputs ===== -->
    <Style x:Key="DarkTextBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource InsetBrush}" />
        <Setter Property="Foreground" Value="{StaticResource Text1Brush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="7"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#4A505A" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Toggle switch (CheckBox) ===== -->
    <Style x:Key="FluentToggleSwitchStyle" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Text1Brush}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Background="Transparent">
                        <ContentPresenter x:Name="Label" VerticalAlignment="Center" Margin="0,0,12,0" RecognizesAccessKey="True" />
                        <Border x:Name="SwitchTrack"
                                Width="40"
                                Height="20"
                                CornerRadius="10"
                                Background="Transparent"
                                BorderBrush="#5B626D"
                                BorderThickness="1.5"
                                SnapsToDevicePixels="True">
                            <Ellipse x:Name="SwitchThumb"
                                     Width="10"
                                     Height="10"
                                     Fill="#9AA1AC"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Center"
                                     Margin="4,0,0,0" />
                        </Border>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasContent" Value="False">
                            <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="#7A818C" />
                            <Setter TargetName="SwitchThumb" Property="Fill" Value="#C2C8D0" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="SwitchTrack" Property="Background" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="SwitchThumb" Property="Fill" Value="{StaticResource OnAccentBrush}" />
                            <Setter TargetName="SwitchThumb" Property="Width" Value="12" />
                            <Setter TargetName="SwitchThumb" Property="Height" Value="12" />
                            <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="SwitchThumb" Property="Margin" Value="0,0,3,0" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="SwitchTrack" Property="Background" Value="{StaticResource AccentHoverBrush}" />
                            <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
                        </MultiTrigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Sidebar navigation item ===== -->
    <Style x:Key="NavItemRadioStyle" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Text2Brush}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="NavBd"
                            Background="Transparent"
                            CornerRadius="8"
                            Padding="10,11">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="IndicatorBar"
                                    Width="3"
                                    Height="16"
                                    CornerRadius="1.5"
                                    Background="Transparent"
                                    VerticalAlignment="Center"
                                    Margin="0,0,10,0" />
                            <TextBlock x:Name="Icon"
                                       Grid.Column="1"
                                       Text="{TemplateBinding Tag}"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="16"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0" />
                            <ContentPresenter Grid.Column="2" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="NavBd" Property="Background" Value="{StaticResource HoverBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource Text1Brush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="NavBd" Property="Background" Value="{StaticResource SelectedBrush}" />
                            <Setter TargetName="IndicatorBar" Property="Background" Value="{StaticResource AccentBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource Text1Brush}" />
                            <Setter Property="FontWeight" Value="Medium" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Segmented selector item ===== -->
    <Style x:Key="SegmentedItemRadioStyle" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Text2Brush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="SegBd"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="7"
                            Padding="12,9">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="SegBd" Property="Background" Value="{StaticResource HoverBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource Text1Brush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="SegBd" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                            <Setter TargetName="SegBd" Property="BorderBrush" Value="{StaticResource AccentSoftBorderBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource Text1Brush}" />
                            <Setter Property="FontWeight" Value="Medium" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SegmentedTrackStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource InsetBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Padding" Value="3" />
    </Style>

    <!-- ===== Settings card ===== -->
    <Style x:Key="SettingsCardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="24,20,24,22" />
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>

    <!-- Thin row divider inside cards -->
    <Style x:Key="RowDivider" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{StaticResource BorderBrush}" />
        <Setter Property="Margin" Value="0,16" />
    </Style>

    <!-- ===== Slider ===== -->
    <Style x:Key="SliderDecreaseStyle" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent">
                        <Border Height="4" CornerRadius="2" Background="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SliderIncreaseStyle" TargetType="RepeatButton" BasedOn="{StaticResource SliderDecreaseStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent">
                        <Border Height="4" CornerRadius="2" Background="{StaticResource TrackBrush}" VerticalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SliderThumbStyle" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid Width="18" Height="18" Background="Transparent">
                        <Ellipse x:Name="Ring" Fill="{StaticResource ThumbBrush}" Stroke="{StaticResource CardBrush}" StrokeThickness="2" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="Fill" Value="#F0F2F5" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Ring" Property="Fill" Value="{StaticResource AccentHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="QuietSliderStyle" TargetType="Slider">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Background="Transparent" MinHeight="26">
                        <Track x:Name="PART_Track" VerticalAlignment="Center">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderDecreaseStyle}" Command="Slider.DecreaseLarge" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource SliderThumbStyle}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderIncreaseStyle}" Command="Slider.IncreaseLarge" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Implicit styles -->
